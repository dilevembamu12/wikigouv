<section class="col-lg-8 mx-auto bg-white border rounded-4 shadow-sm p-4 p-lg-5">
  <h1 class="h3 mb-3">Retour Keycloak (OIDC callback)</h1>
  <% if (data.error) { %>
    <div class="alert alert-danger">
      Erreur OIDC: <strong><%= data.error %></strong><br/>
      <span class="small"><%= data.errorDescription ?? 'Aucune description' %></span>
    </div>
  <% } else if (data.code) { %>
    <div class="alert alert-success">Code OIDC reçu. Prochaine étape: échange du code contre un access token côté backend BFF.</div>
    <p class="small text-muted mb-0">state: <code><%= data.state %></code></p>
  <% } else { %>
    <div class="alert alert-warning">Aucun code reçu. Vérifie la configuration du client Keycloak (redirect URI).</div>
  <% } %>
</section>
