  <script>
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
    }

    const form = document.getElementById('registerForm');
    const submitBtn = document.getElementById('submitBtn');
    const ocrBtn = document.getElementById('btnOcrNiu');
    const startCameraBtn = document.getElementById('btnStartCamera');
    const capturePhotoBtn = document.getElementById('btnCapturePhoto');
    const stopCameraBtn = document.getElementById('btnStopCamera');
    const ocrFileInput = document.getElementById('niu_card_file');
    const ocrPreview = document.getElementById('ocrPreview');
    const cameraWrap = document.getElementById('cameraWrap');
    const cameraVideo = document.getElementById('cameraVideo');
    const cameraCanvas = document.getElementById('cameraCanvas');
    const capturePreviewWrap = document.getElementById('capturePreviewWrap');
    const capturePreview = document.getElementById('capturePreview');
    const alertBox = document.getElementById('formAlert');
    let cameraStream = null;
    let capturedImageBlob = null;
    const requiredFieldIds = ['full_name', 'email', 'phone', 'organization', 'role', 'learning_goals'];
    const fields = {
      full_name: document.getElementById('full_name'),
      email: document.getElementById('email'),
      phone: document.getElementById('phone'),
      organization: document.getElementById('organization'),
      role: document.getElementById('role'),
      learning_goals: document.getElementById('learning_goals'),
      consent_data: document.getElementById('consent_data')
    };
    const defaultSubmitLabel = 'Enregistrer le participant';

    function showAlert(message, type) {
      alertBox.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200', 'bg-red-50', 'text-red-800', 'border-red-200');
      if (type === 'success') {
        alertBox.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
      } else {
        alertBox.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      }
      alertBox.textContent = message;
    }

    function swalNotify(type, title, text) {
      if (typeof Swal === 'undefined') return;
      Swal.fire({
        icon: type,
        title,
        text,
        confirmButtonColor: '#123C73'
      });
    }

    function getValue(id) {
      const el = document.getElementById(id);
      return el ? String(el.value || '').trim() : '';
    }

    function setValue(id, value) {
      const el = document.getElementById(id);
      if (!el) return;
      el.value = String(value || '').trim();
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('blur', { bubbles: true }));
    }

    async function startCamera() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        swalNotify('error', 'Caméra indisponible', 'Votre navigateur ne supporte pas la capture caméra.');
        return;
      }

      try {
        if (cameraStream) {
          stopCamera();
        }

        cameraStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: 'environment' } },
          audio: false
        });

        cameraVideo.srcObject = cameraStream;
        cameraWrap.classList.remove('hidden');
      } catch (error) {
        swalNotify('error', 'Accès caméra refusé', 'Autorisez la caméra pour capturer la carte NIU.');
      }
    }

    function stopCamera() {
      if (cameraStream) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
      }
      cameraVideo.srcObject = null;
      cameraWrap.classList.add('hidden');
    }

    function captureFromCamera() {
      if (!cameraStream || !cameraVideo.videoWidth || !cameraVideo.videoHeight) {
        swalNotify('info', 'Caméra', 'Démarrez la caméra avant de capturer.');
        return;
      }

      cameraCanvas.width = cameraVideo.videoWidth;
      cameraCanvas.height = cameraVideo.videoHeight;
      const ctx = cameraCanvas.getContext('2d');
      ctx.drawImage(cameraVideo, 0, 0, cameraCanvas.width, cameraCanvas.height);

      const dataUrl = cameraCanvas.toDataURL('image/jpeg', 0.92);
      capturePreview.src = dataUrl;
      capturePreviewWrap.classList.remove('hidden');

      cameraCanvas.toBlob((blob) => {
        capturedImageBlob = blob;
      }, 'image/jpeg', 0.92);

      swalNotify('success', 'Capture effectuée', 'Image capturée. Vous pouvez lancer le scan OCR.');
    }

    function ensureErrorNode(fieldId) {
      const field = document.getElementById(fieldId);
      if (!field) return null;
      const parent = field.closest('label') || field.parentElement;
      if (!parent) return null;

      let errorNode = parent.querySelector(`[data-error-for="${fieldId}"]`);
      if (!errorNode) {
        errorNode = document.createElement('p');
        errorNode.className = 'mt-1 text-xs text-red-600 hidden';
        errorNode.setAttribute('data-error-for', fieldId);
        parent.appendChild(errorNode);
      }
      return errorNode;
    }

    function setFieldState(fieldId, valid, message = '') {
      const field = document.getElementById(fieldId);
      if (!field) return;

      const errorNode = ensureErrorNode(fieldId);
      field.classList.remove('border-red-500', 'ring-red-100', 'border-emerald-500', 'ring-emerald-100');

      if (valid) {
        if (message) {
          field.classList.add('border-emerald-500', 'ring-emerald-100');
        }
        if (errorNode) {
          errorNode.textContent = '';
          errorNode.classList.add('hidden');
        }
      } else {
        field.classList.add('border-red-500', 'ring-red-100');
        if (errorNode) {
          errorNode.textContent = message;
          errorNode.classList.remove('hidden');
        }
      }
    }

    function validateEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function validatePhone(phone) {
      const cleaned = phone.replace(/[^\d+]/g, '');
      return cleaned.length >= 8 && cleaned.length <= 16;
    }

    function normalizeDateToInput(rawDate) {
      if (!rawDate) return '';
      const cleaned = rawDate.replace(/[.\-]/g, '/');
      const parts = cleaned.split('/').map(v => v.trim()).filter(Boolean);
      if (parts.length !== 3) return '';

      let day = parts[0];
      let month = parts[1];
      let year = parts[2];

      if (year.length === 2) {
        year = Number(year) > 30 ? `19${year}` : `20${year}`;
      }

      if (day.length === 1) day = `0${day}`;
      if (month.length === 1) month = `0${month}`;

      if (year.length !== 4) return '';
      return `${year}-${month}-${day}`;
    }

    function extractNamedValue(lines, keys) {
      for (const line of lines) {
        const normalized = line.toUpperCase();
        for (const key of keys) {
          if (normalized.includes(key)) {
            const split = line.split(':');
            if (split.length > 1) {
              const value = split.slice(1).join(':').trim();
              if (value) return value;
            }
            const stripped = line.replace(new RegExp(`.*${key}\\s*`, 'i'), '').trim();
            if (stripped && stripped.length > 2) return stripped;
          }
        }
      }
      return '';
    }

    function parseNiuCardText(text) {
      const lines = String(text || '')
        .split('\n')
        .map(l => l.trim())
        .filter(Boolean);

      const rawNiu = extractNamedValue(lines, ['NIU', 'NUI']);
      const niuMatch = rawNiu.match(/[A-Z0-9\-]{6,24}/i) || String(text || '').match(/(?:NIU|NUI)\s*[:\-]?\s*([A-Z0-9\-]{6,24})/i);
      const niuNumber = niuMatch ? String(niuMatch[1] || niuMatch[0]).replace(/^(NIU|NUI)\s*[:\-]?\s*/i, '').trim() : '';

      const nom = extractNamedValue(lines, ['NOM', 'NOMS']);
      const prenom = extractNamedValue(lines, ['PRENOM', 'PRENOMS', 'PRÉNOM', 'PRÉNOMS']);
      const fullname = [nom, prenom].filter(Boolean).join(' ').trim();

      const birthRaw = extractNamedValue(lines, ['DATE DE NAISSANCE', 'NE(E) LE', 'NE LE', 'NÉ(E) LE', 'NÉ LE']);
      const dateMatch = birthRaw.match(/\d{1,2}[\/.\-]\d{1,2}[\/.\-]\d{2,4}/) || String(text || '').match(/\d{1,2}[\/.\-]\d{1,2}[\/.\-]\d{2,4}/);
      const birthDate = dateMatch ? normalizeDateToInput(dateMatch[0]) : '';

      return {
        niu_number: niuNumber,
        full_name: fullname,
        birth_date: birthDate
      };
    }

    async function runNiuOcr() {
      const file = ocrFileInput?.files?.[0];
      const source = capturedImageBlob || file;
      if (!source) {
        swalNotify('info', 'Carte NIU', 'Ajoutez une image de la carte NIU/NUI avant de lancer le scan.');
        return;
      }
      if (typeof Tesseract === 'undefined') {
        swalNotify('error', 'OCR indisponible', 'La librairie OCR n est pas chargee.');
        return;
      }

      ocrBtn.disabled = true;
      ocrBtn.classList.add('opacity-60', 'cursor-not-allowed');

      Swal.fire({
        title: 'Analyse OCR en cours...',
        html: 'Lecture de la carte NIU/NUI',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      try {
        const result = await Tesseract.recognize(source, 'fra+eng', {
          logger: (msg) => {
            if (msg?.status && typeof msg.progress === 'number') {
              const progress = Math.round(msg.progress * 100);
              Swal.update({
                html: `${msg.status}<br><b>${progress}%</b>`
              });
            }
          }
        });

        const text = String(result?.data?.text || '').trim();
        ocrPreview.textContent = text || 'Aucun texte détecté.';

        const parsed = parseNiuCardText(text);

        if (parsed.niu_number) setValue('niu_number', parsed.niu_number);
        if (parsed.full_name) setValue('full_name', parsed.full_name);
        if (parsed.birth_date) setValue('birth_date', parsed.birth_date);

        refreshSubmitState();

        Swal.close();
        swalNotify(
          'success',
          'OCR terminé',
          'Pré-remplissage effectué. Vérifiez les champs avant validation.'
        );
      } catch (error) {
        Swal.close();
        swalNotify('error', 'OCR échoué', 'Impossible de lire correctement la carte. Essayez une photo plus nette.');
      } finally {
        ocrBtn.disabled = false;
        ocrBtn.classList.remove('opacity-60', 'cursor-not-allowed');
      }
    }

    function validateField(fieldId) {
      const value = getValue(fieldId);

      if (fieldId === 'full_name') {
        if (!value) return { ok: false, message: 'Le nom complet est obligatoire.' };
        if (value.length < 3) return { ok: false, message: 'Veuillez saisir un nom plus complet.' };
        return { ok: true };
      }

      if (fieldId === 'email') {
        if (!value) return { ok: false, message: 'L email est obligatoire.' };
        if (!validateEmail(value)) return { ok: false, message: 'Format email invalide.' };
        return { ok: true };
      }

      if (fieldId === 'phone') {
        if (!value) return { ok: false, message: 'Le numero de telephone est obligatoire.' };
        if (!validatePhone(value)) return { ok: false, message: 'Numero de telephone invalide.' };
        return { ok: true };
      }

      if (fieldId === 'organization') {
        if (!value) return { ok: false, message: 'L organisation est obligatoire.' };
        return { ok: true };
      }

      if (fieldId === 'role') {
        if (!value) return { ok: false, message: 'La fonction actuelle est obligatoire.' };
        return { ok: true };
      }

      if (fieldId === 'learning_goals') {
        if (!value) return { ok: false, message: 'Les objectifs d apprentissage sont obligatoires.' };
        if (value.length < 10) return { ok: false, message: 'Merci d ajouter un peu plus de details.' };
        return { ok: true };
      }

      return { ok: true };
    }

    function validateConsentData(showMessage = false) {
      const consent = document.getElementById('consent_data').checked;
      if (!consent && showMessage) {
        swalNotify('warning', 'Consentement requis', 'Veuillez accepter le stockage des donnees.');
      }
      return consent;
    }

    function refreshSubmitState() {
      const hasInvalid = requiredFieldIds.some(id => !validateField(id).ok);
      const hasConsent = document.getElementById('consent_data').checked;
      submitBtn.disabled = hasInvalid || !hasConsent;
      submitBtn.classList.toggle('opacity-60', submitBtn.disabled);
      submitBtn.classList.toggle('cursor-not-allowed', submitBtn.disabled);
    }

    function bindRealtimeValidation() {
      requiredFieldIds.forEach((fieldId) => {
        const field = document.getElementById(fieldId);
        if (!field) return;

        const eventName = field.tagName === 'SELECT' ? 'change' : 'input';
        field.addEventListener(eventName, () => {
          const result = validateField(fieldId);
          if (getValue(fieldId).length > 0) {
            setFieldState(fieldId, result.ok, result.message);
          } else {
            setFieldState(fieldId, true);
          }
          refreshSubmitState();
        });

        field.addEventListener('blur', () => {
          const result = validateField(fieldId);
          setFieldState(fieldId, result.ok, result.message);
          refreshSubmitState();
        });
      });

      const consent = document.getElementById('consent_data');
      consent.addEventListener('change', refreshSubmitState);
    }

    function getFormPayload() {
      return {
        full_name: getValue('full_name'),
        niu_number: getValue('niu_number'),
        email: getValue('email'),
        phone: getValue('phone'),
        gender: getValue('gender'),
        birth_date: getValue('birth_date'),
        city: getValue('city'),
        organization: getValue('organization'),
        direction: getValue('direction'),
        role: getValue('role'),
        years_experience: getValue('years_experience'),
        preferred_mode: getValue('preferred_mode'),
        availability: getValue('availability'),
        learning_goals: getValue('learning_goals'),
        consent_data: document.getElementById('consent_data').checked,
        consent_contact: document.getElementById('consent_contact').checked
      };
    }

    function validateBeforeSubmit(payload) {
      const errors = [];

      requiredFieldIds.forEach((fieldId) => {
        const result = validateField(fieldId);
        setFieldState(fieldId, result.ok, result.message);
        if (!result.ok) errors.push(result.message);
      });

      if (!payload.consent_data) {
        errors.push('Le consentement de stockage des donnees est obligatoire.');
      }

      return errors;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload = getFormPayload();
      const validationErrors = validateBeforeSubmit(payload);

      if (validationErrors.length) {
        showAlert(validationErrors[0], 'error');
        swalNotify('error', 'Formulaire incomplet', validationErrors[0]);
        validateConsentData(true);
        refreshSubmitState();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enregistrement...';

      try {
        const response = await fetch('/api/participants/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          const errorText = data?.error || 'Inscription impossible pour le moment.';
          showAlert(errorText, 'error');
          swalNotify('error', 'Inscription non enregistree', errorText);
          return;
        }

        form.reset();
        showAlert('Inscription enregistrée avec succès. Merci !', 'success');
        requiredFieldIds.forEach((fieldId) => setFieldState(fieldId, true));
        swalNotify('success', 'Inscription validee', 'Le participant a bien ete enregistre.');
      } catch (error) {
        showAlert('Erreur réseau. Veuillez réessayer.', 'error');
        swalNotify('error', 'Erreur reseau', 'Impossible de joindre le serveur.');
      } finally {
        submitBtn.textContent = defaultSubmitLabel;
        refreshSubmitState();
      }
    });

    bindRealtimeValidation();
    startCameraBtn?.addEventListener('click', startCamera);
    capturePhotoBtn?.addEventListener('click', captureFromCamera);
    stopCameraBtn?.addEventListener('click', stopCamera);
    ocrFileInput?.addEventListener('change', () => {
      capturedImageBlob = null;
      capturePreview.src = '';
      capturePreviewWrap.classList.add('hidden');
    });
    ocrBtn?.addEventListener('click', runNiuOcr);
    refreshSubmitState();
  </script>
</body>
</html>
