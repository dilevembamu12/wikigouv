            </label>
            <div class="flex gap-2">
              <button id="btnStartCamera" type="button" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 px-4 py-3 font-semibold hover:bg-slate-100 transition">
