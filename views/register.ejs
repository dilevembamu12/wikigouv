          <input id="organization" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500" />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700">Direction / Département</span>
          <input id="direction" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500" />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700">Fonction actuelle *</span>
          <input id="role" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500" />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700">Années d'expérience</span>
          <input id="years_experience" type="number" min="0" step="1" inputmode="numeric" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500" />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700">Mode de formation préféré</span>
          <select id="preferred_mode" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500">
            <option value="">Sélectionner</option>
            <option value="presentiel">Présentiel</option>
            <option value="distanciel">Distanciel</option>
            <option value="hybride">Hybride</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700">Disponibilité</span>
          <input id="availability" placeholder="Ex: Soir, week-end, horaire bureau" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500" />
        </label>

        <label class="block md:col-span-2">
          <span class="text-sm font-semibold text-slate-700">Objectifs d'apprentissage *</span>
          <textarea id="learning_goals" rows="4" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500" placeholder="Que voulez-vous apprendre sur la plateforme ?"></textarea>
        </label>

        <label class="md:col-span-2 flex items-start gap-3 rounded-xl bg-slate-50 border border-slate-200 p-4">
          <input id="consent_data" type="checkbox" class="mt-1 h-5 w-5 rounded border-slate-300" />
          <span class="text-sm text-slate-700">J'accepte que mes données soient stockées pour la gestion de ma participation. *</span>
        </label>

        <label class="md:col-span-2 flex items-start gap-3 rounded-xl bg-slate-50 border border-slate-200 p-4">
          <input id="consent_contact" type="checkbox" class="mt-1 h-5 w-5 rounded border-slate-300" />
          <span class="text-sm text-slate-700">J'accepte d'être contacté pour les prochaines sessions et informations de formation.</span>
        </label>

        <div class="md:col-span-2 flex flex-col sm:flex-row gap-3 pt-1">
          <button id="submitBtn" type="submit" class="inline-flex items-center justify-center rounded-xl bg-blue-800 text-white px-6 py-3 font-semibold hover:bg-blue-900 transition">
            Enregistrer le participant
