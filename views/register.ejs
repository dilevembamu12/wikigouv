            <option value="">Sélectionner</option>
            <option value="F">Femme</option>
            <option value="M">Homme</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-slate-700">Date de naissance</span>
          <input id="birth_date" type="date" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500" />
