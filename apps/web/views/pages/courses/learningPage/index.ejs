  }
  .learning-page .learning-item-card .item-action-btn[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translate(-50%, 4px);
    background: rgba(14, 20, 34, .96);
    color: #e9f1ff;
    border: 1px solid #3c4f75;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: .72rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 8px 18px rgba(7, 12, 24, .38);
    transition: opacity .16s ease, transform .16s ease;
    z-index: 8;
  }
  .learning-page .learning-item-card .item-action-btn[data-tooltip]::before {
    content: "";
    position: absolute;
    bottom: calc(100% + 3px);
    left: 50%;
    width: 8px;
    height: 8px;
    transform: translateX(-50%) rotate(45deg);
    background: rgba(14, 20, 34, .96);
    border-right: 1px solid #3c4f75;
    border-bottom: 1px solid #3c4f75;
    opacity: 0;
    pointer-events: none;
    transition: opacity .16s ease;
    z-index: 7;
  }
