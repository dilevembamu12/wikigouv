    opacity: 1;
    transform: translate(-50%, 0);
  }
  .learning-page .learning-item-card .item-action-btn[data-tooltip]:hover::before,
  .learning-page .learning-item-card .item-action-btn[data-tooltip]:focus-visible::before {
    opacity: 1;
  }
  .learning-page .learning-item-card.active,
  .learning-page .learning-item-card.is-active {
    box-shadow: 0 12px 28px rgba(8, 13, 24, .38) !important;
    border-color: #5c6f9a !important;
  }
  @media (max-width: 991px) {
