<%
  const course = data.course;
  const progress = data.progress && typeof data.progress === 'object' ? data.progress : {};
  const meta = course && course.metadata && typeof course.metadata === 'object' ? course.metadata : {};
  const title = String(course?.title ?? '').replace(/^\[(COURSE|LIVE|TEXT)\]\s*/i, '').trim() || 'Cours';
  const courseType = String(meta.type ?? course?.type ?? 'course');
  const sections = Array.isArray(course?.sections) ? course.sections : [];
  const extrasByType = course && typeof course.extrasByType === 'object' ? course.extrasByType : {};
  const quizzes = Array.isArray(course?.quizzes) ? course.quizzes : [];
  const certificates = Array.isArray(course?.certificates) ? course.certificates : [];
  const noticeboards = Array.isArray(course?.noticeboards) ? course.noticeboards : [];
  const forumTopics = Array.isArray(course?.forumTopics) ? course.forumTopics : [];
  const userName = String(data?.page?.user?.name ?? data?.page?.user?.email ?? 'Utilisateur');
  const rawAvatar = String(
    data?.page?.user?.avatarUrl ??
      data?.page?.user?.picture ??
      ''
  ).trim();
  const userAvatar = rawAvatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(userName)}&background=1c73e8&color=fff`;
  const noticeboardsCount = noticeboards.length;
  const forumEnabled = true;
  const completedCount = Number(progress.completedLessons ?? 0);
  const totalLessons = Number(progress.totalLessons ?? 0);
  const pct = Math.max(0, Math.min(100, Number(progress.progressPercentage ?? 0)));

  const lessonsBySection = [];
  sections.forEach((section, sIdx) => {
    const sTitle = String(section?.title ?? `Section ${sIdx + 1}`);
    const items = Array.isArray(section?.contentItems) ? section.contentItems : [];
    const mapped = items.map((it, iIdx) => ({
      key: `${String(it.type ?? 'item')}:${String(it.id ?? `${sIdx}-${iIdx}`)}`,
      id: String(it.id ?? ''),
      title: String(it.title ?? `${String(it.type ?? 'Item')} ${iIdx + 1}`),
      type: String(it.type ?? 'item'),
      description: String((it.payload && (it.payload.description || it.payload.summary)) ?? ''),
      payload: it.payload ?? {},
      mediaPath: String((it.payload && (it.payload.video_demo || it.payload.video || it.payload.file_path || it.payload.path || it.payload.link || it.payload.url)) ?? ''),
      source: String((it.payload && (it.payload.video_demo_source || it.payload.storage || it.payload.source)) ?? ''),
      fileType: String((it.payload && (it.payload.file_type || it.payload.type)) ?? ''),
      scormIndex: String((it.payload && (it.payload.interactive_file_name || it.payload.index_file_name)) ?? '')
    }));
    lessonsBySection.push({
      id: String(section?.id ?? `section-${sIdx}`),
      title: sTitle,
      items: mapped
    });
  });

  const standaloneTypes = ['file', 'interactive_file', 'text_lesson', 'session', 'assignment'];
  const standaloneItems = standaloneTypes
    .flatMap((k) => Array.isArray(extrasByType[k]) ? extrasByType[k].map((x) => ({ ...x, type: k })) : [])
    .map((it, idx) => ({
      key: `${String(it.type ?? 'item')}:${String(it.id ?? `standalone-${idx}`)}`,
      id: String(it.id ?? ''),
      title: String(it.title ?? `${String(it.type ?? 'Item')} ${idx + 1}`),
      type: String(it.type ?? 'item'),
      description: String((it.payload && (it.payload.description || it.payload.summary)) ?? ''),
      payload: it.payload ?? {},
      mediaPath: String((it.payload && (it.payload.video_demo || it.payload.video || it.payload.file_path || it.payload.path || it.payload.link || it.payload.url)) ?? ''),
      source: String((it.payload && (it.payload.video_demo_source || it.payload.storage || it.payload.source)) ?? ''),
      fileType: String((it.payload && (it.payload.file_type || it.payload.type)) ?? ''),
      scormIndex: String((it.payload && (it.payload.interactive_file_name || it.payload.index_file_name)) ?? '')
    }));

  if (standaloneItems.length) {
    lessonsBySection.unshift({
      id: 'general',
      title: 'Before Starting the Course',
      items: standaloneItems
    });
  }

  const contentItemsTotal = lessonsBySection.reduce((acc, s) => acc + s.items.length, 0);
  const initialItem = lessonsBySection[0]?.items?.[0] ?? null;
%>

<div class="learning-page">
<section
  class="learning-shell"
  id="learningPageRoot"
  data-course-id="<%= String(course?.id ?? '') %>"
  data-completed="<%- encodeURIComponent(JSON.stringify(progress?.completedItems ?? {})) %>"
  data-server-last-view="<%- encodeURIComponent(JSON.stringify(data?.serverLastView ?? {})) %>"
  data-debug="<%= String(page?.query?.debugLearning ?? '') === '1' ? '1' : '0' %>"
>
  <% if (!course) { %>
    <div class="alert alert-warning mb-3">Cours introuvable ou non accessible.</div>
    <a href="/courses" class="btn btn-primary">Retour au catalogue</a>
  <% } else { %>
    <%- include('./components/navbar', { title, courseType, course, pct, noticeboardsCount, forumEnabled }) %>

    <div class="d-flex position-relative">
      <div class="learning-page-content flex-grow-1 bg-info-light p-15">
        <%- include('./components/content', { initialItem }) %>
        <div id="learningDebugPanel" class="learning-debug-panel d-none"></div>
      </div>

      <aside class="learning-page-tabs show">
        <div class="learning-learner-card">
          <div class="learning-learner-header">
            <div class="learning-learner-user">
              <img src="<%= userAvatar %>" alt="<%= userName %>" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(userName) %>&background=1c73e8&color=fff';">
              <div class="learning-learner-meta">
                <div class="learning-learner-name"><%= userName %></div>
                <div class="learning-learner-role">Student</div>
              </div>
            </div>
          </div>
          <div class="learning-learner-progress">
            <div class="progress">
              <div id="learningProgressBar" class="progress-bar" style="width: <%= pct %>%"></div>
            </div>
            <div class="learning-learner-progress-text">
              <span id="learningPct"><%= pct %></span>% Study Progress
            </div>
            <div class="learning-learner-progress-meta">
              <span id="learningDoneCount"><%= completedCount %></span>/<span id="learningTotalCount"><%= totalLessons || contentItemsTotal %></span> completed
            </div>
          </div>
        </div>
        <ul class="learning-tabs nav nav-tabs py-15 d-flex align-items-center justify-content-around" id="tabs-tab" role="tablist">
          <li class="nav-item">
            <a href="#content" class="tab nav-link is-active active position-relative font-14 d-flex align-items-center" id="content-tab" data-tab="content" role="tab" aria-controls="content" aria-selected="true">
              <i class="learning-page-tabs-icons mr-5 fa-solid fa-grip"></i>
              <span class="learning-page-tabs-link-text">Contenu</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="#quizzes" class="tab nav-link position-relative font-14 d-flex align-items-center" id="quizzes-tab" data-tab="quizzes" role="tab" aria-controls="quizzes" aria-selected="false">
              <i class="learning-page-tabs-icons mr-5 fa-regular fa-clipboard"></i>
              <span class="learning-page-tabs-link-text">Quiz</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="#certificates" class="tab nav-link position-relative font-14 d-flex align-items-center" id="certificates-tab" data-tab="certs" role="tab" aria-controls="certificates" aria-selected="false">
              <i class="learning-page-tabs-icons mr-5 fa-regular fa-award"></i>
              <span class="learning-page-tabs-link-text">Certificats</span>
            </a>
          </li>
        </ul>
        <div class="tab-content h-100" id="nav-tabContent">
          <%- include('./components/content_tab/index', { lessonsBySection, course }) %>
          <%- include('./components/quiz_tab/index', { quizzes }) %>
          <%- include('./components/certificate_tab/index', { certificates }) %>
        </div>
      </aside>
    </div>
  <% } %>
</section>
</div>
