    border: 1px solid rgba(74, 96, 136, .55);
    box-shadow: 0 8px 18px rgba(8, 13, 24, .35);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity .18s ease, transform .18s ease, box-shadow .2s ease;
    pointer-events: none;
    z-index: 3;
