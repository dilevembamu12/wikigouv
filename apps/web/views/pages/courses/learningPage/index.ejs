      padding-bottom: 8px;
    }
    .learning-page .learning-item-card .learning-item-actions {
      position: static;
      margin-top: 8px !important;
      width: 100%;
      justify-content: flex-end;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 0;
    }
    .learning-page .learning-item-card .item-action-btn.item-action-open::after {
      content: "";
      margin-left: 0;
    }
    .learning-page .learning-item-card .item-action-btn.item-action-open {
      width: 32px;
      min-width: 32px;
      padding: 0;
      border-radius: 8px !important;
    }
    .learning-page .learning-item-card .item-action-btn[data-tooltip]::after,
