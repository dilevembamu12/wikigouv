<div class="learning-panel content-tab p-15 pb-50 pb-20 tab-pane fade show active h-100" id="content" role="tabpanel" aria-labelledby="content-tab" data-panel="content">
  <% if (!lessonsBySection.length) { %>
    <div class="learning-page-forum-empty d-flex align-items-center justify-content-center flex-column">
      <div class="learning-page-forum-empty-icon d-flex align-items-center justify-content-center">
        <img src="/assets/default/img/learning/content-empty.svg" class="img-fluid" alt="">
      </div>
      <div class="d-flex align-items-center flex-column mt-10 text-center">
        <h3 class="font-20 font-weight-bold text-dark-blue text-center">Aucun contenu disponible !</h3>
        <p class="font-14 font-weight-500 text-gray mt-5 text-center">Vous pouvez ajouter du contenu pedagogique pour les apprenants.</p>
      </div>
    </div>
  <% } else { %>
    <div class="learning-content-tools mb-10">
      <div class="learning-content-search-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input id="learningContentSearch" type="text" class="form-control" placeholder="Rechercher une leçon, section, type..." autocomplete="off">
      </div>
      <div id="learningContentSearchMeta" class="learning-content-search-meta"></div>
    </div>
    <% lessonsBySection.forEach((section, sIndex) => { %>
      <%- include('./chapter', { section, sIndex, course }) %>
    <% }) %>
  <% } %>
</div>
