<div class="learning-panel content-tab p-15 pb-50 pb-20 tab-pane fade h-100" id="certificates" role="tabpanel" aria-labelledby="certificates-tab" data-panel="certs">
  <% if (!certificates.length) { %>
    <div class="learning-page-forum-empty d-flex align-items-center justify-content-center flex-column">
      <div class="learning-page-forum-empty-icon d-flex align-items-center justify-content-center">
        <img src="/assets/default/img/learning/certificate-empty.svg" class="img-fluid" alt="">
      </div>
      <div class="d-flex align-items-center flex-column mt-10 text-center">
        <h3 class="font-20 font-weight-bold text-dark-blue text-center">No Certificates Available!</h3>
        <p class="font-14 font-weight-500 text-gray mt-5 text-center">Complete quizzes and course objectives to unlock certificates.</p>
      </div>
    </div>
  <% } else { %>
    <% certificates.forEach((c) => { %>
      <div class="certificate-item cursor-pointer p-10 border border-gray200 rounded-sm mb-15">
        <div class="d-flex align-items-center">
          <span class="chapter-icon bg-gray300 mr-10">
            <i class="fa-regular fa-award text-gray" style="font-size:16px"></i>
          </span>
          <div class="flex-grow-1">
            <span class="font-weight-500 font-14 text-dark-blue d-block"><%= String(c.title ?? 'Course Certificate') %></span>
            <div class="d-flex align-items-center">
              <span class="font-12 text-gray"><%= String(c.status ?? 'ACTIVE') %></span>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
