<%
  const course = data.course;
  const progress = data.progress && typeof data.progress === 'object' ? data.progress : {};
  const meta = course && course.metadata && typeof course.metadata === 'object' ? course.metadata : {};
  const title = String(course?.title ?? '').replace(/^\[(COURSE|LIVE|TEXT)\]\s*/i, '').trim() || 'Cours';
  const category = String(meta.category ?? 'Cours');
  const courseType = String(meta.type ?? course?.type ?? 'course');
  const locale = String(meta.locale ?? 'FR');
  const sections = Array.isArray(course?.sections) ? course.sections : [];
  const extrasByType = course && typeof course.extrasByType === 'object' ? course.extrasByType : {};
  const quizzes = Array.isArray(course?.quizzes) ? course.quizzes : [];
  const certificates = Array.isArray(course?.certificates) ? course.certificates : [];
  const userName = String(data?.page?.user?.name ?? data?.page?.user?.email ?? 'Utilisateur');
  const rawAvatar = String(
    data?.page?.user?.avatarUrl ??
      data?.page?.user?.picture ??
      ''
  ).trim();
  const userAvatar = rawAvatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(userName)}&background=1c73e8&color=fff`;
  const completedCount = Number(progress.completedLessons ?? 0);
  const totalLessons = Number(progress.totalLessons ?? 0);
  const pct = Math.max(0, Math.min(100, Number(progress.progressPercentage ?? 0)));

  const lessonsBySection = [];
  sections.forEach((section, sIdx) => {
    const sTitle = String(section?.title ?? `Section ${sIdx + 1}`);
    const items = Array.isArray(section?.contentItems) ? section.contentItems : [];
    const mapped = items.map((it, iIdx) => ({
      key: `${String(it.type ?? 'item')}:${String(it.id ?? `${sIdx}-${iIdx}`)}`,
      id: String(it.id ?? ''),
      title: String(it.title ?? `${String(it.type ?? 'Item')} ${iIdx + 1}`),
      type: String(it.type ?? 'item'),
      description: String((it.payload && (it.payload.description || it.payload.summary)) ?? ''),
      payload: it.payload ?? {},
      mediaPath: String(
        (it.payload && (it.payload.video_demo || it.payload.video || it.payload.file_path || it.payload.path || it.payload.link || it.payload.url)) ??
          ''
      ),
      source: String((it.payload && (it.payload.video_demo_source || it.payload.storage || it.payload.source)) ?? ''),
      scormIndex: String((it.payload && (it.payload.interactive_file_name || it.payload.index_file_name)) ?? ''),
      fileType: String((it.payload && (it.payload.file_type || it.payload.type)) ?? '')
    }));
    lessonsBySection.push({
      id: String(section?.id ?? `section-${sIdx}`),
      title: sTitle,
      items: mapped
    });
  });

  const standaloneTypes = ['file', 'interactive_file', 'text_lesson', 'session', 'assignment'];
  const standaloneItems = standaloneTypes
    .flatMap((k) => Array.isArray(extrasByType[k]) ? extrasByType[k].map((x) => ({ ...x, type: k })) : [])
    .map((it, idx) => ({
      key: `${String(it.type ?? 'item')}:${String(it.id ?? `standalone-${idx}`)}`,
      id: String(it.id ?? ''),
      title: String(it.title ?? `${String(it.type ?? 'Item')} ${idx + 1}`),
      type: String(it.type ?? 'item'),
      description: String((it.payload && (it.payload.description || it.payload.summary)) ?? ''),
      payload: it.payload ?? {},
      mediaPath: String(
        (it.payload && (it.payload.video_demo || it.payload.video || it.payload.file_path || it.payload.path || it.payload.link || it.payload.url)) ??
          ''
      ),
      source: String((it.payload && (it.payload.video_demo_source || it.payload.storage || it.payload.source)) ?? ''),
      scormIndex: String((it.payload && (it.payload.interactive_file_name || it.payload.index_file_name)) ?? ''),
      fileType: String((it.payload && (it.payload.file_type || it.payload.type)) ?? '')
    }));

  if (standaloneItems.length) {
    lessonsBySection.unshift({
      id: 'general',
      title: 'Avant de commencer le cours',
      items: standaloneItems
    });
  }

  const contentItemsTotal = lessonsBySection.reduce((acc, s) => acc + s.items.length, 0);
  const initialItem = lessonsBySection[0]?.items?.[0] ?? null;
  const initialSectionTitle = lessonsBySection[0]?.title ?? '';
%>

<section
  class="learning-shell"
  id="learningPageRoot"
  data-course-id="<%= String(course?.id ?? '') %>"
  data-completed="<%- encodeURIComponent(JSON.stringify(progress?.completedItems ?? {})) %>"
  data-server-last-view="<%- encodeURIComponent(JSON.stringify(data?.serverLastView ?? {})) %>"
>
  <% if (!course) { %>
    <div class="alert alert-warning mb-3">Cours introuvable ou non accessible.</div>
    <a href="/courses" class="btn btn-primary">Retour au catalogue</a>
  <% } else { %>
    <div class="learning-topbar">
      <div>
        <h1 class="learning-title"><%= title %></h1>
        <div class="learning-breadcrumb-lite">Rocket LMS <span>></span> <%= courseType === 'webinar' ? 'Classe en direct' : courseType === 'text_lesson' ? 'Cours texte' : 'Cours video' %> <span>></span> Page d apprentissage</div>
      </div>
      <div class="learning-tools">
        <a href="/courses/<%= encodeURIComponent(String(course?.slug ?? '')) %>" class="btn btn-sm btn-outline-secondary px-3 me-2">Page du cours</a>
        <a href="/courses" class="btn btn-sm btn-outline-secondary px-3 me-2">Mes cours</a>
        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3"><i class="fa-solid fa-gear me-1"></i> Outils du cours</button>
      </div>
    </div>

    <div class="learning-grid">
      <div class="learning-main">
        <div class="learning-player-card">
          <div id="learningPlayerLoading" class="learning-loading">
            <div class="learning-dots"><span></span><span></span><span></span></div>
            <h4>Veuillez patienter...</h4>
            <p>Chargement du contenu en cours...</p>
          </div>
          <div id="learningPlayerContent" class="learning-content d-none">
            <div class="learning-player-stage" id="learningPlayerStage">
              <div class="learning-player-placeholder">
                <i class="fa-regular fa-circle-play"></i>
                <p>Selectionnez un contenu pour commencer</p>
              </div>
            </div>
            <div class="learning-type-badge" id="learningCurrentType"><%= initialItem?.type ?? 'item' %></div>
            <h2 id="learningCurrentTitle"><%= initialItem?.title ?? 'Aucun contenu disponible' %></h2>
            <p id="learningCurrentDesc"><%= initialItem?.description || 'Selectionnez un element du plan de cours a droite.' %></p>
            <div class="learning-pass-line">
              <span>J'ai termine cette lecon</span>
              <button type="button" class="learning-pass-toggle" id="learningPassToggle" aria-label="Marquer termine"></button>
            </div>
            <div class="learning-actions">
              <button class="btn btn-outline-secondary btn-sm" id="learningPrevBtn">Precedent</button>
              <button class="btn btn-outline-secondary btn-sm" id="learningNextBtn">Suivant</button>
              <button class="btn btn-primary btn-sm" id="learningDoneBtn">Marquer termine</button>
            </div>
          </div>
        </div>
      </div>

      <aside class="learning-sidebar">
        <div class="learner-card">
          <div class="learner-user">
            <img src="<%= userAvatar %>" alt="<%= userName %>" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(userName) %>&background=1c73e8&color=fff';">
            <div>
              <div class="name"><%= userName %></div>
              <div class="role">Apprenant</div>
            </div>
          </div>
          <div class="progress-wrap">
            <div class="progress-value"><span id="learningPct"><%= pct %></span>% progression</div>
            <div class="progress"><div class="progress-bar" id="learningProgressBar" style="width:<%= pct %>%"></div></div>
            <div class="progress-meta"><span id="learningDoneCount"><%= completedCount %></span>/<span id="learningTotalCount"><%= totalLessons || contentItemsTotal %></span> contenus termines</div>
          </div>
        </div>

        <div class="learning-tabs">
          <button class="tab is-active" data-tab="content">Contenu</button>
          <button class="tab" data-tab="quizzes">Quiz</button>
          <button class="tab" data-tab="certs">Certificats</button>
        </div>

        <div class="learning-panel" data-panel="content">
          <% if (!lessonsBySection.length) { %>
            <div class="empty">Aucun contenu de cours disponible.</div>
          <% } %>

          <% lessonsBySection.forEach((section, sIndex) => { %>
            <div class="section-card <%= sIndex === 0 ? 'is-open' : '' %>" data-section-id="<%= section.id %>">
              <div class="section-head-wrap">
                <button type="button" class="section-head js-toggle-section">
                  <div class="section-title-wrap">
                    <span class="section-icon"><i class="fa-solid fa-grip"></i></span>
                    <div>
                      <div class="section-title"><%= section.title %></div>
                      <div class="section-meta"><%= section.items.length %> Topic <%= section.items.length ? '| 0 Hr' : '' %></div>
                    </div>
                  </div>
                </button>
                <div class="section-actions">
                  <div class="dropdown">
                    <button class="section-action-btn action-plus" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Ajouter du contenu">
                      <i class="fa-solid fa-plus"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm learning-add-menu">
                      <li><button type="button" class="dropdown-item js-add-item" data-add-type="file" data-section-id="<%= section.id %>">Ajouter un fichier</button></li>
                      <li><button type="button" class="dropdown-item js-add-item" data-add-type="interactive_file" data-section-id="<%= section.id %>">Nouveau fichier SCORM</button></li>
                      <li><button type="button" class="dropdown-item js-add-item" data-add-type="text_lesson" data-section-id="<%= section.id %>">Ajouter une lecon texte</button></li>
                      <li><button type="button" class="dropdown-item js-add-item" data-add-type="quiz" data-section-id="<%= section.id %>">Ajouter un quiz</button></li>
                      <li><button type="button" class="dropdown-item js-add-item" data-add-type="assignment" data-section-id="<%= section.id %>">Ajouter un devoir</button></li>
                    </ul>
                  </div>
                  <button type="button" class="section-action-btn js-section-action" data-action="edit" data-section-id="<%= section.id %>" title="Modifier la section"><i class="fa-regular fa-pen-to-square"></i></button>
                  <button type="button" class="section-action-btn js-section-action" data-action="delete" data-section-id="<%= section.id %>" title="Supprimer la section"><i class="fa-regular fa-trash-can"></i></button>
                  <button type="button" class="section-action-btn js-section-action" data-action="sort" data-section-id="<%= section.id %>" title="Trier"><i class="fa-solid fa-up-down-left-right"></i></button>
                  <button type="button" class="section-action-btn js-toggle-section" title="Replier/Deplier"><i class="fa-solid fa-angle-up"></i></button>
                </div>
              </div>
              <div class="section-head-info">
                <div>
                  <div class="section-title"><%= section.title %></div>
                  <div class="section-meta"><%= section.items.length %> Topic <%= section.items.length ? '| 0 Hr' : '' %></div>
                </div>
              </div>
              <div class="section-body">
                <% section.items.forEach((it, idx) => { %>
                  <% const itemIcon = it.type === 'file' ? 'fa-regular fa-file-lines'
                    : it.type === 'interactive_file' ? 'fa-regular fa-file-zipper'
                    : it.type === 'text_lesson' ? 'fa-regular fa-file-word'
                    : it.type === 'session' ? 'fa-solid fa-video'
                    : it.type === 'quiz' ? 'fa-regular fa-clipboard'
                    : it.type === 'assignment' ? 'fa-regular fa-bookmark'
                    : 'fa-regular fa-file-lines'; %>
                  <% const itemMeta = it.type === 'quiz' ? 'Quiz'
                    : it.type === 'session' ? 'Video'
                    : it.type === 'text_lesson' ? 'Text Lesson'
                    : it.type === 'interactive_file' ? 'SCORM'
                    : 'Video'; %>
                  <button
                    type="button"
                    class="item-row js-learning-item <%= sIndex === 0 && idx === 0 ? 'is-active' : '' %>"
                    data-item-key="<%= it.key %>"
                    data-item-id="<%= it.id %>"
                    data-item-title="<%- it.title %>"
                    data-item-type="<%= it.type %>"
                    data-item-desc="<%- it.description %>"
                    data-item-media="<%- it.mediaPath %>"
                    data-item-source="<%- it.source %>"
                    data-item-scorm-index="<%- it.scormIndex %>"
                    data-item-file-type="<%- it.fileType %>"
                    data-item-section="<%- section.title %>">
                    <span class="icon"><i class="<%= itemIcon %>"></i></span>
                    <span class="body">
                      <span class="name"><%= it.title %></span>
                      <span class="meta"><%= itemMeta %></span>
                    </span>
                    <span class="done d-none"><i class="fa-solid fa-check"></i></span>
                  </button>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="learning-panel d-none" data-panel="quizzes">
          <% if (!quizzes.length) { %>
            <div class="empty">Aucun quiz disponible.</div>
          <% } else { %>
            <% quizzes.forEach((q) => { %>
              <div class="mini-row">
                <div class="name"><%= String(q.title ?? 'Quiz') %></div>
                <div class="meta"><%= String(q.status ?? 'ACTIVE') %></div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="learning-panel d-none" data-panel="certs">
          <% if (!certificates.length) { %>
            <div class="empty">Aucun certificat disponible.</div>
          <% } else { %>
            <% certificates.forEach((c) => { %>
              <div class="mini-row">
                <div class="name"><%= String(c.title ?? 'Certificat') %></div>
                <div class="meta"><%= String(c.status ?? 'ACTIVE') %></div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </aside>
    </div>

    <input type="hidden" id="learningInitialSectionTitle" value="<%= initialSectionTitle %>">
    <input type="hidden" id="learningLocale" value="<%= locale %>">
    <input type="hidden" id="learningCategory" value="<%= category %>">
  <% } %>
</section>

<style>
  .learning-shell{max-width:100%;padding:6px 0}
  .learning-topbar{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
  .learning-title{font-size:42px;font-weight:700;line-height:1.12;margin:0;color:#12213f;letter-spacing:-.02em}
  .learning-breadcrumb-lite{margin-top:6px;font-size:13px;color:#93a0bb}
  .learning-breadcrumb-lite span{margin:0 8px;color:#c3ccdf}
  .learning-grid{display:grid;grid-template-columns:1fr 384px;gap:16px}
  .learning-player-card{min-height:620px;border:1px solid #dce5f4;border-radius:20px;background:#fff;padding:14px;position:relative}
  .learning-loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
  .learning-dots span{display:inline-block;width:20px;height:20px;background:#0d1320;border-radius:50%;margin:0 4px;animation:dotPulse 1.1s infinite ease-in-out}
  .learning-dots span:nth-child(2){animation-delay:.15s}.learning-dots span:nth-child(3){animation-delay:.3s}
  .learning-loading h4{margin-top:18px;font-weight:700}.learning-loading p{color:#99a5bf}
  .learning-content{height:100%;display:flex;flex-direction:column;justify-content:flex-start;align-items:stretch;max-width:1000px;margin:0 auto;width:100%}
  .learning-player-stage{width:100%;height:430px;border:1px solid #dce5f4;border-radius:14px;background:#f8fbff;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .learning-player-stage iframe,.learning-player-stage video,.learning-player-stage img{width:100%;height:100%;object-fit:cover;border:0}
  .learning-player-stage video{background:#000}
  .learning-video-controls{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid #dce5f4;border-top:0;border-radius:0 0 14px 14px;background:#fff}
  .learning-video-controls .btn-ctrl{border:0;background:#edf4ff;color:#1c73e8;width:34px;height:34px;border-radius:999px;display:flex;align-items:center;justify-content:center}
  .learning-video-controls .btn-ctrl:hover{background:#dbe9ff}
  .learning-video-controls input[type="range"]{accent-color:#1c73e8}
  .learning-video-time{font-size:12px;color:#6f7f9d;min-width:78px;text-align:center}
  .learning-player-stage .pdf-view{width:100%;height:100%;border:0;background:#fff}
  .learning-player-placeholder{text-align:center;color:#8ea1c2}
  .learning-player-placeholder i{font-size:48px;margin-bottom:10px}
  .learning-type-badge{display:inline-flex;padding:6px 10px;border-radius:999px;background:#eef2fb;color:#3f5378;font-size:12px;margin-bottom:10px}
  .learning-content h2{font-size:30px;line-height:1.2;margin:14px 0 8px}.learning-content p{color:#667594}
  .learning-pass-line{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:320px;margin:6px 0 10px;color:#263a5e}
  .learning-pass-toggle{width:50px;height:30px;border-radius:999px;border:1px solid #cbd8ee;background:#eef3fc;position:relative}
  .learning-pass-toggle::after{content:'';position:absolute;top:3px;left:4px;width:22px;height:22px;border-radius:50%;background:#9fb2d2;transition:.2s}
  .learning-pass-toggle.is-on{background:#d7f2df;border-color:#b6e7c5}
  .learning-pass-toggle.is-on::after{left:23px;background:#26b15f}
  .learning-actions{display:flex;gap:8px;margin-top:14px}
  .learner-card{background:#1c73e8;border-radius:18px;padding:10px;color:#fff;box-shadow:0 10px 24px rgba(28,115,232,.2)}
  .learner-user{background:#fff;border-radius:13px;padding:10px 11px;display:flex;gap:10px;align-items:center;color:#0f1a2f}
  .learner-user img{width:46px;height:46px;border-radius:999px}.learner-user .name{font-weight:700}.learner-user .role{font-size:12px;color:#7887a6}
  .progress-wrap{margin-top:10px}.progress-value{font-size:12px;margin-bottom:5px}.progress-meta{font-size:12px;margin-top:4px;color:#d5e6ff}
  .progress{height:10px;border-radius:999px;background:rgba(255,255,255,.35)}
  .progress .progress-bar{border-radius:999px;background:#ffffff}
  .learning-tabs{display:flex;background:#f2f6fd;border-radius:999px;padding:5px;margin:14px 0}
  .learning-tabs .tab{flex:1;border:0;background:transparent;border-radius:999px;padding:9px 8px;font-weight:600;color:#7e8fad;font-size:15px}
  .learning-tabs .tab.is-active{background:#fff;color:#13213f;box-shadow:0 2px 9px rgba(17,35,72,.1)}
  .learning-panel{max-height:640px;overflow:auto;padding-right:2px}
  .learning-panel::-webkit-scrollbar{width:8px}
  .learning-panel::-webkit-scrollbar-thumb{background:#d7e0f2;border-radius:999px}
  .section-card{border:1px solid #e5ebf7;border-radius:15px;margin-bottom:10px;background:#fff}
  .section-head-wrap{display:flex;align-items:center;justify-content:space-between;padding:12px 12px 10px}
  .section-head{border:0;background:transparent;padding:0;flex:1;min-width:0;text-align:left}
  .section-head-info{display:none}
  .section-title-wrap{display:flex;align-items:center;gap:10px}
  .section-icon{width:44px;height:44px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:#eaf2ff;color:#2680eb}
  .section-title{font-weight:700;font-size:32px;line-height:1.06;color:#13203d;letter-spacing:-.01em}
  .section-meta{font-size:14px;color:#98a5bf}
  .section-actions{display:flex;align-items:center;gap:12px}
  .section-action-btn{width:28px;height:28px;border:0;background:transparent;color:#90a2c2;display:flex;align-items:center;justify-content:center;border-radius:999px;font-size:14px}
  .section-action-btn:hover{background:#eef4ff;color:#2d6ad4}
  .action-plus{background:#d3f5de;color:#29a15f;width:30px;height:30px}
  .learning-add-menu{min-width:230px;border-radius:12px;border:1px solid #e5ebf7;box-shadow:0 18px 40px rgba(18,36,71,.16)}
  .learning-add-menu .dropdown-item{padding:.52rem .9rem;font-size:14px;color:#6c7d9d}
  .learning-add-menu .dropdown-item:hover{background:#f6f9ff;color:#1d6fe8}
  .section-body{padding:0 12px 12px}
  .section-card:not(.is-open) .section-body{display:none}
  .section-card:not(.is-open) .section-action-btn .fa-angle-up{transform:rotate(180deg)}
  .item-row{width:100%;display:flex;align-items:center;gap:10px;border:0;background:#f7f9fe;border-radius:12px;padding:13px 11px;margin-top:8px;text-align:left}
  .item-row .icon{width:38px;height:38px;border-radius:11px;background:#e8eef8;display:flex;align-items:center;justify-content:center;color:#8da0c1}
  .item-row .body{display:flex;flex-direction:column}.item-row .name{font-weight:700;color:#182947}
  .item-row .meta{font-size:13px;color:#95a4c0;text-transform:capitalize}
  .item-row .done{margin-left:auto;color:#2ebd65}
  .item-row.is-active{outline:2px solid #d5e6ff;background:#edf4ff;box-shadow:0 4px 10px rgba(28,115,232,.08)}
  .empty{border:1px dashed #d3deef;border-radius:12px;padding:16px;color:#8c9bb9;background:#f8fbff}
  .mini-row{border:1px solid #e6edf8;border-radius:12px;padding:10px;margin-bottom:8px}
  .mini-row .name{font-weight:700;color:#1d2a46}.mini-row .meta{font-size:12px;color:#95a4c0}
  @keyframes dotPulse{0%,100%{transform:scale(.65)}50%{transform:scale(1)}}
  @media (max-width:1200px){
    .learning-grid{grid-template-columns:1fr}
    .learning-sidebar{order:-1}
    .section-title{font-size:21px}
  }
</style>

<script src="/js/learning-player.js"></script>
