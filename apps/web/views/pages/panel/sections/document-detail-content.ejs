<section class="rocket-card p-4">
  <% if (data.document) { %>
    <h1 class="h5 rocket-title mb-3"><%= data.document.title ?? 'Untitled document' %></h1>
    <div class="row g-3">
      <div class="col-md-6"><div class="rocket-muted">Type</div><div class="fw-semibold"><%= data.document.type ?? '-' %></div></div>
      <div class="col-md-6"><div class="rocket-muted">Status</div><div class="fw-semibold"><%= data.document.status ?? '-' %></div></div>
      <div class="col-md-6"><div class="rocket-muted">Version</div><div class="fw-semibold"><%= data.document.version ?? '-' %></div></div>
      <div class="col-md-6"><div class="rocket-muted">Source</div><div class="fw-semibold"><%= data.document.source ?? '-' %></div></div>
    </div>
    <div class="mt-4 d-flex gap-2">
      <form method="post" action="/documents/<%= data.document.id %>/process">
        <button class="btn btn-outline-warning" type="submit">Process</button>
      </form>
      <form method="post" action="/documents/<%= data.document.id %>/validate">
        <button class="btn btn-outline-success" type="submit">Validate</button>
      </form>
      <a href="/documents" class="btn btn-outline-secondary">Back</a>
    </div>
  <% } else { %>
    <div class="text-muted">Document introuvable (API status: <%= data.documentsStatus ?? 0 %>)</div>
    <a href="/documents" class="btn btn-outline-secondary mt-3">Back</a>
  <% } %>
</section>

