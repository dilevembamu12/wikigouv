<section class="rocket-card p-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h2 class="h5 mb-1">IAM dynamique (Keycloak)</h2>
      <p class="text-muted mb-0">Gestion des roles utilisateurs en temps reel.</p>
    </div>
    <form action="/admin/iam" method="get" class="d-flex flex-wrap gap-2">
      <input type="text" name="q" value="<%= data.search || '' %>" class="form-control" placeholder="Rechercher un utilisateur">
      <select name="role" class="form-select">
        <option value="">Tous les roles</option>
        <% (data.iamRoles || []).forEach((r) => { %>
          <option value="<%= r.name %>" <%= (data.selectedRole || '') === r.name ? 'selected' : '' %>><%= r.name %></option>
        <% }) %>
      </select>
      <input type="hidden" name="upage" value="1">
      <input type="hidden" name="apage" value="<%= data.auditsPage || 1 %>">
      <input type="hidden" name="usize" value="<%= data.usersPageSize || 20 %>">
      <input type="hidden" name="asize" value="<%= data.auditsPageSize || 15 %>">
      <button class="btn btn-primary" type="submit">Filtrer</button>
      <a class="btn btn-outline-secondary" href="/admin/iam">Reset</a>
    </form>
  </div>

  <% if (data.rolesStatus >= 400 || data.usersStatus >= 400) { %>
    <div class="alert alert-warning">
      Chargement partiel IAM (roles: <%= data.rolesStatus %>, users: <%= data.usersStatus %>).
    </div>
  <% } %>

  <div class="table-responsive">
    <table class="table table-bordered align-middle">
      <thead>
        <tr>
          <th>Utilisateur</th>
          <th>Email</th>
          <th>Roles Keycloak (wikigouv-api)</th>
          <th style="width: 180px;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!data.iamUsers || data.iamUsers.length === 0) { %>
          <tr>
            <td colspan="4" class="text-center text-muted py-4">Aucun utilisateur trouve.</td>
          </tr>
        <% } %>
        <% (data.iamUsers || []).forEach((u) => { %>
          <tr>
            <td>
              <div class="fw-semibold"><%= u.firstName || '' %> <%= u.lastName || '' %></div>
              <small class="text-muted"><%= u.username || u.id %></small>
            </td>
            <td><%= u.email || '-' %></td>
            <td>
              <div class="mb-2">
                <% (u.roles || []).forEach((ur) => { %>
                  <span class="badge bg-primary-subtle text-primary me-1"><%= ur %></span>
                <% }) %>
                <% if (!(u.roles || []).length) { %>
                  <span class="badge bg-secondary-subtle text-secondary">Aucun role</span>
                <% } %>
              </div>
              <form method="post" action="/admin/iam/users/<%= u.id %>/roles" class="js-roles-form">
                <div class="row g-2">
                  <% (data.iamRoles || []).forEach((role) => { %>
                    <div class="col-6">
                      <div class="form-check">
                        <input
                          class="form-check-input"
                          type="checkbox"
                          name="roles"
                          id="role_<%= u.id %>_<%= role.name %>"
                          value="<%= role.name %>"
                          <%= (u.roles || []).includes(role.name) ? 'checked' : '' %>
                        >
                        <label class="form-check-label small" for="role_<%= u.id %>_<%= role.name %>"><%= role.name %></label>
                      </div>
                    </div>
                  <% }) %>
                </div>
                <div class="mt-3">
                  <input type="hidden" name="q" value="<%= data.search || '' %>">
                  <input type="hidden" name="role" value="<%= data.selectedRole || '' %>">
                  <button class="btn btn-sm btn-primary" type="submit">Mettre a jour roles</button>
                </div>
              </form>
            </td>
            <td>
              <span class="badge <%= u.enabled ? 'bg-success' : 'bg-secondary' %>"><%= u.enabled ? 'Actif' : 'Inactif' %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if ((data.usersTotalPages || 1) > 1) { %>
    <nav class="mt-3">
      <ul class="pagination pagination-sm mb-0">
        <% for (let i = 1; i <= data.usersTotalPages; i++) { %>
          <li class="page-item <%= i === (data.usersPage || 1) ? 'active' : '' %>">
            <a
              class="page-link"
              href="/admin/iam?upage=<%= i %>&usize=<%= data.usersPageSize || 20 %>&apage=<%= data.auditsPage || 1 %>&asize=<%= data.auditsPageSize || 15 %>&q=<%= encodeURIComponent(data.search || '') %>&role=<%= encodeURIComponent(data.selectedRole || '') %>"
            ><%= i %></a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</section>

<section class="rocket-card p-4 mt-4">
  <h3 class="h6 mb-3">Historique IAM (audit)</h3>
  <div class="table-responsive">
    <table class="table table-sm align-middle">
      <thead>
        <tr>
          <th>Date</th>
          <th>Action</th>
          <th>Actor</th>
          <th>User cible</th>
          <th>IP</th>
        </tr>
      </thead>
      <tbody>
        <% if (!(data.iamAudits || []).length) { %>
          <tr><td colspan="5" class="text-muted text-center py-3">Aucun log IAM pour le moment.</td></tr>
        <% } %>
        <% (data.iamAudits || []).forEach((a) => { %>
          <tr>
            <td><small><%= a.createdAt ? new Date(a.createdAt).toLocaleString() : '-' %></small></td>
            <td><span class="badge bg-dark-subtle text-dark"><%= a.action || '-' %></span></td>
            <td><small><%= a.actorUserId || '-' %></small></td>
            <td><small><%= a.entityId || '-' %></small></td>
            <td><small><%= a.ipAddress || '-' %></small></td>
          </tr>
          <% if (a.metadata) { %>
            <tr>
              <td></td>
              <td colspan="4">
                <small class="text-muted">
                  + Ajoutes: <%= ((a.metadata.addedRoles || [])).join(', ') || '-' %> |
                  - Retires: <%= ((a.metadata.removedRoles || [])).join(', ') || '-' %>
                </small>
              </td>
            </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if ((data.iamAudits || []).length >= (data.auditsPageSize || 15)) { %>
    <nav class="mt-2">
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item <%= (data.auditsPage || 1) <= 1 ? 'disabled' : '' %>">
          <a
            class="page-link"
            href="/admin/iam?upage=<%= data.usersPage || 1 %>&usize=<%= data.usersPageSize || 20 %>&apage=<%= Math.max(1, (data.auditsPage || 1) - 1) %>&asize=<%= data.auditsPageSize || 15 %>&q=<%= encodeURIComponent(data.search || '') %>&role=<%= encodeURIComponent(data.selectedRole || '') %>"
          >Prev</a>
        </li>
        <li class="page-item active"><span class="page-link"><%= data.auditsPage || 1 %></span></li>
        <li class="page-item">
          <a
            class="page-link"
            href="/admin/iam?upage=<%= data.usersPage || 1 %>&usize=<%= data.usersPageSize || 20 %>&apage=<%= (data.auditsPage || 1) + 1 %>&asize=<%= data.auditsPageSize || 15 %>&q=<%= encodeURIComponent(data.search || '') %>&role=<%= encodeURIComponent(data.selectedRole || '') %>"
          >Next</a>
        </li>
      </ul>
    </nav>
  <% } %>
</section>

<script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
<script>
  document.querySelectorAll('.js-roles-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const result = await Swal.fire({
        title: 'Confirmer la mise a jour ?',
        text: 'Les roles Keycloak seront modifies immediatement.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Oui, mettre a jour',
        cancelButtonText: 'Annuler'
      });
      if (result.isConfirmed) {
        form.submit();
      }
    });
  });
</script>
