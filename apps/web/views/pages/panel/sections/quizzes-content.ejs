<section class="rocket-card p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h1 class="h5 rocket-title mb-1">Quiz & Evaluations</h1>
      <p class="rocket-muted mb-0">Pilotage des quiz, tentatives et performance apprenants.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createQuizModal"><i class="fa-solid fa-plus me-2"></i>Create Quiz</button>
  </div>
</section>

<section class="row g-3 mb-4">
  <div class="col-md-4"><div class="rocket-card p-3"><div class="rocket-muted">Active Quizzes</div><div class="fs-3 fw-bold"><%= (quizzes || []).length %></div></div></div>
  <div class="col-md-4"><div class="rocket-card p-3"><div class="rocket-muted">API Status</div><div class="fs-3 fw-bold"><%= quizzesStatus ?? 0 %></div></div></div>
  <div class="col-md-4"><div class="rocket-card p-3"><div class="rocket-muted">Average Score</div><div class="fs-3 fw-bold">--</div></div></div>
</section>

<div class="modal fade" id="createQuizModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/quizzes/create">
        <div class="modal-header">
          <h5 class="modal-title">Create Quiz</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">Title</label>
          <input class="form-control" name="title" required placeholder="Quiz title" />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create</button>
        </div>
      </form>
    </div>
  </div>
</div>

<section class="rocket-card p-0 overflow-hidden">
  <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
    <h2 class="h6 mb-0 rocket-title">Recent Quizzes</h2>
    <div class="btn-group btn-group-sm">
      <button class="btn btn-outline-secondary">Draft</button>
      <button class="btn btn-primary">Published</button>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Quiz</th>
          <th>Attempts</th>
          <th>Pass Rate</th>
          <th>Status</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (quizzes && quizzes.length > 0) { %>
          <% for (const quiz of quizzes) { %>
            <tr>
              <td><%= quiz.title ?? quiz.name ?? 'Untitled quiz' %></td>
              <td><%= quiz.attempts ?? 0 %></td>
              <td><%= quiz.passRate ?? '-' %></td>
              <td><span class="badge text-bg-light border"><%= quiz.status ?? 'UNKNOWN' %></span></td>
              <td class="text-end"><button class="btn btn-sm btn-outline-primary">Open</button></td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No quizzes found (API status: <%= quizzesStatus ?? 0 %>)</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
