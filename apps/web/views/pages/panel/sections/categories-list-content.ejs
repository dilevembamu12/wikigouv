<section class="rocket-page">
  <div class="rocket-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
      <h2 class="h2 fw-bold mb-0">Categories</h2>
      <a href="/admin/categories/create" class="btn btn-primary rounded-pill px-4">+ Nouvelle categorie</a>
    </div>
  </div>

  <div class="rocket-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h3 class="h5 fw-bold mb-1">Liste des categories</h3>
        <div class="text-muted">Easily manage and review all related items in this list.</div>
      </div>
    </div>

    <% if ((data.listStatus ?? 200) !== 200) { %>
      <div class="alert alert-warning">API indisponible (status <%= data.listStatus %>)</div>
    <% } %>

    <div class="table-responsive">
      <table class="table table-borderless align-middle rocket-table">
        <thead>
          <tr>
            <th>Icon</th>
            <th class="text-start">Order</th>
            <th class="text-start">Title</th>
            <th>Subcategory</th>
            <th>Cours</th>
            <th>Instructors</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% (data.categories ?? []).forEach((category) => { %>
            <tr>
              <td>
                <% if (category.icon) { %>
                  <img src="<%= category.icon %>" alt="icon" width="34" class="rounded-circle border">
                <% } else { %>
                  -
                <% } %>
              </td>
              <td class="text-start"><%= category.order ?? '-' %></td>
              <td class="text-start"><%= category.title ?? '-' %></td>
              <td><%= category.subCategoryCount ?? 0 %></td>
              <td><%= category.coursesCount ?? 0 %></td>
              <td><%= category.instructorsCount ?? 0 %></td>
              <td>
                <details class="position-relative d-inline-block">
                  <summary class="btn btn-light rounded-circle px-2 py-1 border-0">•••</summary>
                  <div class="dropdown-menu show position-absolute p-2" style="min-width: 140px; right: 0; left: auto;">
                    <a href="/admin/categories/<%= category.id %>/edit" class="dropdown-item text-primary">Edit</a>
                    <form method="post" action="/admin/categories/<%= category.id %>/delete" class="js-delete-form">
                      <button type="submit" class="dropdown-item text-danger">Delete</button>
                    </form>
                  </div>
                </details>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .rocket-page-header{background:#fff;border-radius:18px;padding:22px 26px}
  .rocket-table thead th{background:#f4f6fb;color:#98a3bf;font-weight:700;border:0}
  .rocket-table td,.rocket-table th{padding:16px 14px}
  details[open] summary{opacity:.9}
  details summary{list-style:none}
  details summary::-webkit-details-marker{display:none}
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.querySelectorAll('.js-delete-form').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      Swal.fire({
        icon: 'warning',
        title: 'Delete category?',
        text: 'This will also remove sub-categories and linked trends.',
        showCancelButton: true,
        confirmButtonText: 'Delete',
        cancelButtonText: 'Cancel'
      }).then(function (result) {
        if (result.isConfirmed) form.submit();
      });
    });
  });
</script>
