<section class="rocket-card p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h1 class="h5 rocket-title mb-1">Support Tickets</h1>
      <p class="rocket-muted mb-0">Suivi des incidents utilisateurs et demandes d'assistance LMS/SSO.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSupportModal"><i class="fa-solid fa-life-ring me-2"></i>Open Ticket</button>
  </div>
</section>

<section class="row g-3 mb-4">
  <div class="col-md-4"><div class="rocket-card p-3"><div class="rocket-muted">Open</div><div class="fs-3 fw-bold"><%= (supports || []).filter((s) => s.status === 'OPEN').length %></div></div></div>
  <div class="col-md-4"><div class="rocket-card p-3"><div class="rocket-muted">Pending</div><div class="fs-3 fw-bold"><%= (supports || []).filter((s) => s.status === 'PENDING').length %></div></div></div>
  <div class="col-md-4"><div class="rocket-card p-3"><div class="rocket-muted">API Status</div><div class="fs-3 fw-bold"><%= supportsStatus ?? 0 %></div></div></div>
</section>

<div class="modal fade" id="createSupportModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/support/create">
        <div class="modal-header">
          <h5 class="modal-title">Create Support Ticket</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Subject</label>
            <input class="form-control" name="subject" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea class="form-control" name="message" rows="4" required></textarea>
          </div>
          <div>
            <label class="form-label">Priority</label>
            <select class="form-select" name="priority">
              <option value="MEDIUM">MEDIUM</option>
              <option value="HIGH">HIGH</option>
              <option value="LOW">LOW</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit Ticket</button>
        </div>
      </form>
    </div>
  </div>
</div>

<section class="rocket-card p-0 overflow-hidden">
  <div class="p-3 border-bottom">
    <h2 class="h6 mb-0 rocket-title">Latest Tickets</h2>
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Subject</th>
          <th>Requester</th>
          <th>Priority</th>
          <th>Status</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (supports && supports.length > 0) { %>
          <% for (const ticket of supports) { %>
            <tr>
              <td><%= ticket.subject ?? ticket.title ?? 'No subject' %></td>
              <td><%= ticket.requester ?? ticket.userId ?? '-' %></td>
              <td><span class="badge text-bg-info"><%= ticket.priority ?? 'Normal' %></span></td>
              <td><span class="badge text-bg-light border"><%= ticket.status ?? 'OPEN' %></span></td>
              <td class="text-end"><button class="btn btn-sm btn-outline-primary">Open</button></td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No tickets found (API status: <%= supportsStatus ?? 0 %>)</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
