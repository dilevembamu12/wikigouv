<section class="rocket-card p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h1 class="h5 rocket-title mb-1">Course Forum</h1>
      <p class="rocket-muted mb-0">Questions/réponses pédagogiques sur les cours et les cas FinTraX.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newTopicModal"><i class="fa-solid fa-pen-to-square me-2"></i>New Topic</button>
  </div>
</section>

<section class="rocket-card p-0 overflow-hidden">
  <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
    <h2 class="h6 mb-0 rocket-title">Recent Topics</h2>
    <input class="form-control form-control-sm" style="max-width:240px;" placeholder="Search topic..." />
  </div>
  <div class="list-group list-group-flush">
    <% if (topics && topics.length > 0) { %>
      <% for (const topic of topics) { %>
        <a href="#" class="list-group-item list-group-item-action py-3">
          <div class="fw-semibold"><%= topic.title ?? topic.subject ?? 'Untitled topic' %></div>
          <div class="rocket-muted"><%= topic.author ?? topic.userId ?? 'User' %> · <%= topic.replies ?? 0 %> réponses</div>
        </a>
      <% } %>
    <% } else { %>
      <div class="list-group-item py-3 text-muted">No topics found (API status: <%= topicsStatus ?? 0 %>)</div>
    <% } %>
  </div>
</section>

<div class="modal fade" id="newTopicModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/forum/create">
        <div class="modal-header">
          <h5 class="modal-title">New Forum Topic</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input class="form-control" name="title" required />
          </div>
          <div>
            <label class="form-label">Content</label>
            <textarea class="form-control" name="content" rows="4" required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Topic</button>
        </div>
      </form>
    </div>
  </div>
</div>
