<% if (!data.allowed) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <h1 class="h5 mb-3">Accès non autorisé</h1>
      <p class="text-muted mb-3">Votre rôle ne permet pas d'accéder à cette section.</p>
      <a href="/unauthorized" class="btn btn-outline-secondary btn-sm">Voir le détail</a>
    </div>
  </div>
<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <h1 class="h5 mb-3"><%= data.featureTitle %></h1>
      <% if (data.comingSoon) { %>
        <p class="text-muted mb-0">Cette interface est prête côté navigation et sera branchée à l'API dans la prochaine tranche.</p>
      <% } else { %>
        <p class="text-muted mb-0">Cette interface est disponible.</p>
      <% } %>
    </div>
  </div>
<% } %>
