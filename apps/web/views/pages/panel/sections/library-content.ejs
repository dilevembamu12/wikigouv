<%
  const picker = !!data.picker;
  const target = data.target || '';
  const folder = data.folder || '';
%>
<section class="rocket-page">
  <div class="library-shell">
    <aside class="library-sidebar">
      <div class="library-sidebar-title"><i class="fa fa-folder-open me-2"></i>Files</div>
      <div id="libraryFoldersNav" class="library-folders-nav"></div>
    </aside>

    <div class="library-main">
      <div class="library-topbar">
        <div class="library-title">Files</div>
        <div class="library-actions-inline">
          <button type="button" id="toggleThumbs" class="btn btn-sm btn-dark">Thumbnails</button>
          <button type="button" id="toggleList" class="btn btn-sm btn-outline-dark">List</button>
          <button type="button" id="toggleSort" class="btn btn-sm btn-outline-dark">Sort</button>
        </div>
      </div>
      <div id="libraryBreadcrumb" class="library-breadcrumb mt-2 mb-2"></div>

      <div class="library-toolbar">
        <input type="text" id="libraryFolder" class="form-control" value="<%= folder %>" placeholder="folder">
        <input type="text" id="librarySearch" class="form-control" placeholder="search keyword">
        <button type="button" id="libraryReload" class="btn btn-outline-primary">Reload</button>
        <button type="button" id="bulkMoveBtn" class="btn btn-outline-warning">Bulk Move</button>
        <button type="button" id="bulkDeleteBtn" class="btn btn-outline-danger">Bulk Delete</button>
        <button type="button" id="libraryNewFolder" class="btn btn-outline-secondary">New Folder</button>
        <label class="btn btn-primary mb-0">
          Upload
          <input id="libraryUploadInput" type="file" class="d-none">
        </label>
      </div>

      <div id="libraryState" class="text-muted mb-3">Loading...</div>

      <div id="libraryListWrap" class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Type</th>
              <th>Size</th>
              <th>Updated</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody id="libraryRows"></tbody>
        </table>
      </div>

      <div id="libraryThumbsWrap" class="d-none library-thumbs"></div>

      <button id="libraryQuickAdd" type="button" class="library-fab">
        <i class="fa fa-plus"></i>
      </button>
      <div id="libraryContextMenu" class="library-context-menu d-none"></div>
    </div>
  </div>
</section>

<div
  id="libraryPageConfig"
  data-picker="<%= picker ? '1' : '0' %>"
  data-target="<%= target %>"
  class="d-none"
></div>
<script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/js/library.js"></script>

<style>
  .library-shell{display:grid;grid-template-columns:280px 1fr;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e9edf5}
  .library-sidebar{background:#f6f7fb;border-right:1px solid #e3e8f0}
  .library-sidebar-title{padding:20px;font-weight:700;border-bottom:1px solid #e3e8f0}
  .library-folders-nav{padding:10px 0}
  .library-folder-item{display:block;padding:12px 20px;color:#273142;text-decoration:none}
  .library-folder-item.active{background:#e9f0ff;color:#155eef;font-weight:600}
  .library-main{position:relative;padding:18px 18px 24px}
  .library-topbar{display:flex;justify-content:space-between;align-items:center;background:#2f3645;color:#fff;padding:10px 14px;border-radius:8px}
  .library-title{font-size:20px;font-weight:600}
  .library-actions-inline{display:flex;gap:8px}
  .library-toolbar{display:grid;grid-template-columns:1.1fr 1fr auto auto auto;gap:8px;padding:12px 0}
  .library-breadcrumb{font-size:13px;color:#667085}
  .library-thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}
  .library-thumb-card{border:1px solid #e6ebf3;border-radius:10px;padding:10px;background:#fff}
  .library-thumb-media{height:110px;display:flex;align-items:center;justify-content:center;background:#f3f6fb;border-radius:8px;margin-bottom:8px;overflow:hidden}
  .library-thumb-media img{max-width:100%;max-height:100%}
  .library-fab{position:absolute;right:22px;bottom:18px;width:56px;height:56px;border:none;border-radius:50%;background:#2f3645;color:#fff;font-size:22px;box-shadow:0 6px 18px rgba(10,20,40,.25)}
  .library-dropzone{outline:2px dashed #91b4ff;outline-offset:-8px}
  .library-context-menu{position:fixed;background:#fff;border:1px solid #e5eaf3;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:2000;min-width:170px;padding:6px}
  .library-context-menu button{display:block;width:100%;text-align:left;border:none;background:transparent;padding:8px 10px;border-radius:6px}
  .library-context-menu button:hover{background:#f2f6ff}
  @media (max-width: 992px){.library-shell{grid-template-columns:1fr}.library-sidebar{display:none}.library-toolbar{grid-template-columns:1fr 1fr}.library-fab{position:fixed;right:18px;bottom:20px;z-index:20}}
</style>
