<section class="rocket-card p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h1 class="h5 rocket-title mb-1">Documents Réglementaires</h1>
      <p class="rocket-muted mb-0">Upload, traitement OCR/IA et validation documentaire pour la base RAG.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadDocumentModal"><i class="fa-solid fa-upload me-2"></i>Upload Document</button>
  </div>
</section>

<section class="row g-3 mb-4">
  <div class="col-md-3"><div class="rocket-card p-3"><div class="rocket-muted">Uploaded</div><div class="fs-3 fw-bold"><%= (documents || []).filter((d) => d.status === 'UPLOADED').length %></div></div></div>
  <div class="col-md-3"><div class="rocket-card p-3"><div class="rocket-muted">Processing</div><div class="fs-3 fw-bold"><%= (documents || []).filter((d) => d.status === 'PROCESSING').length %></div></div></div>
  <div class="col-md-3"><div class="rocket-card p-3"><div class="rocket-muted">Validated</div><div class="fs-3 fw-bold"><%= (documents || []).filter((d) => d.status === 'VALIDATED').length %></div></div></div>
  <div class="col-md-3"><div class="rocket-card p-3"><div class="rocket-muted">Archived</div><div class="fs-3 fw-bold"><%= (documents || []).filter((d) => d.status === 'ARCHIVED').length %></div></div></div>
</section>

<section class="rocket-card p-0 overflow-hidden">
  <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
    <h2 class="h6 mb-0 rocket-title">Document Queue</h2>
    <input class="form-control form-control-sm" style="max-width: 260px;" placeholder="Search document..." />
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th>Version</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (documents && documents.length > 0) { %>
          <% for (const doc of documents) { %>
            <tr>
              <td><%= doc.title ?? 'Untitled' %></td>
              <td><%= doc.type ?? '-' %></td>
              <td><span class="badge text-bg-light border"><%= doc.status ?? '-' %></span></td>
              <td><%= doc.version ?? '-' %></td>
              <td class="text-end d-flex justify-content-end gap-2">
                <a class="btn btn-sm btn-outline-primary" href="/documents/<%= doc.id %>">View</a>
                <form method="post" action="/documents/<%= doc.id %>/process">
                  <button class="btn btn-sm btn-outline-warning" type="submit">Process</button>
                </form>
                <form method="post" action="/documents/<%= doc.id %>/validate">
                  <button class="btn btn-sm btn-outline-success" type="submit">Validate</button>
                </form>
              </td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No documents found (API status: <%= documentsStatus ?? 0 %>)</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<div class="modal fade" id="uploadDocumentModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/documents/upload" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title">Upload Document</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">File (PDF, DOCX, TXT)</label>
          <input class="form-control" type="file" name="file" required />
          <p class="rocket-muted mt-2 mb-0">Maximum: 10MB</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Upload</button>
        </div>
      </form>
    </div>
  </div>
</div>
