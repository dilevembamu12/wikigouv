<section class="rocket-page">
  <div class="rocket-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
      <h2 class="h2 fw-bold mb-0">Instructor Requests Settings</h2>
    </div>
  </div>

  <div class="rocket-card p-4">
    <form method="post" action="/admin/users/become-instructors/settings">
      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="set_instructor_requests_enabled" name="instructor_requests_enabled"
          <%= String(data.settings?.instructor_requests_enabled ?? 'true') === 'true' ? 'checked' : '' %>>
        <label class="form-check-label" for="set_instructor_requests_enabled">Enable instructor requests</label>
      </div>

      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="set_organization_requests_enabled" name="organization_requests_enabled"
          <%= String(data.settings?.organization_requests_enabled ?? 'true') === 'true' ? 'checked' : '' %>>
        <label class="form-check-label" for="set_organization_requests_enabled">Enable organization requests</label>
      </div>

      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="set_instructor_auto_approve" name="instructor_auto_approve"
          <%= String(data.settings?.instructor_auto_approve ?? 'false') === 'true' ? 'checked' : '' %>>
        <label class="form-check-label" for="set_instructor_auto_approve">Auto-approve instructor requests</label>
      </div>

      <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</section>

