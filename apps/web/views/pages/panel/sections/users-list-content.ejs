<% if (data.segment === 'organizations') { %>
<section class="rocket-page org-page">
  <div class="rocket-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
      <h2 class="h2 fw-bold mb-0">Liste des organisations</h2>
      <div class="small text-muted"><a class="text-decoration-none" href="/admin/all-users">Utilisateurs</a></div>
    </div>
  </div>

  <% const totalOrganizations = Number(data.total ?? 0); %>
  <% const verifiedOrganizations = (data.items ?? []).filter((it) => String(it.status ?? '').toUpperCase() === 'ACTIVE').length; %>
  <% const organizationsInstructors = (data.items ?? []).filter((it) => String(it.jobTitle ?? '').toLowerCase().includes('instructor') || String(it.jobTitle ?? '').toLowerCase().includes('formateur')).length; %>
  <% const organizationStudents = (data.items ?? []).filter((it) => String(it.status ?? '').toUpperCase() === 'STUDENT').length; %>

  <div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
      <div class="rocket-card p-3 org-metric-card">
        <div class="d-flex justify-content-between align-items-center">
          <div class="org-metric-title">Total Organizations</div>
          <div class="org-metric-icon bg-primary-subtle text-primary"><i class="fa-solid fa-building-columns"></i></div>
        </div>
        <div class="org-metric-value"><%= totalOrganizations %></div>
      </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <div class="rocket-card p-3 org-metric-card">
        <div class="d-flex justify-content-between align-items-center">
          <div class="org-metric-title">Verified Organizations</div>
          <div class="org-metric-icon bg-success-subtle text-success"><i class="fa-solid fa-certificate"></i></div>
        </div>
        <div class="org-metric-value"><%= verifiedOrganizations %></div>
      </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <div class="rocket-card p-3 org-metric-card">
        <div class="d-flex justify-content-between align-items-center">
          <div class="org-metric-title">Organizations' Instructors</div>
          <div class="org-metric-icon bg-secondary-subtle text-secondary"><i class="fa-solid fa-graduation-cap"></i></div>
        </div>
        <div class="org-metric-value"><%= organizationsInstructors %></div>
      </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <div class="rocket-card p-3 org-metric-card">
        <div class="d-flex justify-content-between align-items-center">
          <div class="org-metric-title">Organization Students</div>
          <div class="org-metric-icon bg-danger-subtle text-danger"><i class="fa-solid fa-briefcase"></i></div>
        </div>
        <div class="org-metric-value"><%= organizationStudents %></div>
      </div>
    </div>
  </div>

  <div class="rocket-card p-4 mb-4">
    <form method="get" class="row g-3 align-items-end" id="orgFilterForm">
      <div class="col-12 col-md-6 col-xl-4">
        <label class="form-label">Recherche</label>
        <input type="text" name="q" class="form-control" value="<%= data.q ?? '' %>">
      </div>
      <div class="col-12 col-md-6 col-xl-4">
        <label class="form-label">Start Date</label>
        <input type="text" name="dateFrom" class="form-control" placeholder="jj/mm/aaaa">
      </div>
      <div class="col-12 col-md-6 col-xl-4">
        <label class="form-label">End Date</label>
        <input type="text" name="dateTo" class="form-control" placeholder="jj/mm/aaaa">
      </div>
      <div class="col-12 col-md-6 col-xl-3">
        <label class="form-label">Filtres</label>
        <select class="form-select" name="type">
          <option value="">Filtrer par type</option>
          <option value="all">All</option>
          <option value="verified">Verified</option>
        </select>
      </div>
      <div class="col-12 col-md-6 col-xl-3">
        <label class="form-label">User Group</label>
        <select class="form-select" name="group">
          <option value="">Select a User Group</option>
        </select>
      </div>
      <div class="col-12 col-md-6 col-xl-3">
        <label class="form-label">Statut</label>
        <select class="form-select" name="status">
          <option value="">Tous les statuts</option>
          <option value="ACTIVE" <%= String(data.status ?? '').toUpperCase() === 'ACTIVE' ? 'selected' : '' %>>Active</option>
          <option value="INACTIVE" <%= String(data.status ?? '').toUpperCase() === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <div class="col-12 col-md-6 col-xl-3 d-grid">
        <button class="btn btn-primary org-result-btn" type="submit">Afficher</button>
      </div>
    </form>
  </div>

  <div class="rocket-card p-0 overflow-hidden mb-4">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
      <div>
        <h3 class="h5 fw-bold mb-1">Organizations</h3>
        <div class="text-muted">Manage all registered organizations and their associated users.</div>
      </div>
      <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary rounded-pill px-3" href="/admin/organizations/export.csv">
          <i class="fa-solid fa-download me-1"></i> Exporter Excel
        </a>
        <a class="btn btn-primary rounded-pill px-4" href="/admin/users/create">
          <i class="fa-solid fa-plus me-1"></i> Nouvel utilisateur
        </a>
      </div>
    </div>

    <% if ((data.listStatus ?? 200) !== 200) { %>
      <div class="p-4">
        <div class="alert alert-warning mb-0">API indisponible (status <%= data.listStatus %>)</div>
      </div>
    <% } %>

    <div class="table-responsive p-4 pt-3">
      <table class="table table-borderless align-middle rocket-table org-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Sales</th>
            <th>Meeting Sales</th>
            <th>Purchased Courses</th>
            <th>Purchased Meetings</th>
            <th>Instructors</th>
            <th>Students</th>
            <th>Registration Date</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if ((data.items ?? []).length === 0) { %>
            <tr>
              <td colspan="11" class="text-center text-muted py-5">Aucune organisation trouvee.</td>
            </tr>
          <% } %>
          <% (data.items ?? []).forEach((item, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="org-avatar"><%= String(item.fullName ?? 'O').charAt(0).toUpperCase() %></span>
                  <div>
                    <div class="fw-semibold"><%= item.fullName ?? '-' %></div>
                    <div class="text-muted"><%= item.email ?? '-' %></div>
                  </div>
                </div>
              </td>
              <td>0<br><span class="text-muted">0</span></td>
              <td>0<br><span class="text-muted">0</span></td>
              <td>0<br><span class="text-muted">0</span></td>
              <td>0<br><span class="text-muted">0</span></td>
              <td>0</td>
              <td>0</td>
              <td><%= item.createdAt ? new Date(item.createdAt).toLocaleDateString() : '-' %></td>
              <td>
                <span class="org-status-badge <%= String(item.status ?? '').toUpperCase() === 'ACTIVE' ? 'active' : 'inactive' %>">
                  <%= String(item.status ?? '').toUpperCase() === 'ACTIVE' ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td>
                <details class="position-relative d-inline-block org-actions">
                  <summary class="org-actions-btn">•••</summary>
                  <div class="dropdown-menu show position-absolute p-2" style="min-width: 160px; right: 0; left: auto;">
                    <a href="/admin/users/<%= item.id %>/edit" class="dropdown-item text-primary">Edit</a>
                    <form method="post" action="/admin/users/<%= item.id %>/delete" class="js-delete-user-form">
                      <button type="submit" class="dropdown-item text-danger">Delete</button>
                    </form>
                  </div>
                </details>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="rocket-card p-4">
    <h4 class="h5 fw-bold mb-3">Hints</h4>
    <div class="row g-4">
      <div class="col-12 col-lg-4">
        <h5 class="org-hint-title">Add New Organization</h5>
        <p class="mb-0">To add a new organization, create a new user with "Organization" role or edit a user from the user list and change the user role to "Organization" and save. The user will be turned to an organization.</p>
      </div>
      <div class="col-12 col-lg-4">
        <h5 class="org-hint-title">Organization Statuses</h5>
        <p class="mb-0">Organizations that their email or phone number was approved after the registration process will be considered as "Active". You can also define a blue badge for organizations.</p>
      </div>
      <div class="col-12 col-lg-4">
        <h5 class="org-hint-title">Organizations Functionality</h5>
        <p class="mb-0">Each organization can include related instructors and students. Organizations can create public or private classes.</p>
      </div>
    </div>
  </div>
</section>

<script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
<link rel="stylesheet" href="/css/users-organizations.css">
<script src="/js/users-organizations.js"></script>
<% } else { %>
<section class="rocket-page">
  <div class="rocket-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
      <h2 class="h2 fw-bold mb-0">
        <% if (data.segment === 'all-users') { %>Utilisateurs<% } %>
        <% if (data.segment === 'staffs') { %>Staff<% } %>
        <% if (data.segment === 'students') { %>Students<% } %>
        <% if (data.segment === 'instructors') { %>Instructors<% } %>
        <% if (data.segment === 'organizations') { %>Organizations<% } %>
        <% if (data.segment === 'restricted') { %>Access Restricted<% } %>
        <% if (data.segment === 'login-history') { %>Historique des connexions<% } %>
        <% if (data.segment === 'instructor-requests') { %>Demandes formateurs<% } %>
      </h2>
      <% if (['all-users', 'staffs', 'students', 'instructors', 'organizations'].includes(data.segment)) { %>
        <a href="/admin/users/create" class="btn btn-primary rounded-pill px-4">+ Nouvel utilisateur</a>
      <% } %>
    </div>
  </div>

  <div class="rocket-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h3 class="h5 fw-bold mb-1">Liste des utilisateurs</h3>
        <div class="text-muted">Easily manage and review related users in this list.</div>
      </div>
    </div>

    <form method="get" class="row g-2 mb-3">
      <div class="col-md-5">
        <input type="text" name="q" class="form-control" placeholder="Rechercher par nom, email, departement..." value="<%= data.q ?? '' %>">
      </div>
      <div class="col-md-3">
        <input type="text" name="status" class="form-control" placeholder="Statut (ACTIVE, RESTRICTED...)" value="<%= data.status ?? '' %>">
      </div>
      <div class="col-md-2">
        <input type="number" min="1" max="100" name="pageSize" class="form-control" value="<%= data.pageSize ?? 10 %>">
      </div>
      <div class="col-md-2 d-grid">
        <button class="btn btn-primary" type="submit">Filter</button>
      </div>
    </form>

    <% if ((data.listStatus ?? 200) !== 200) { %>
      <div class="alert alert-warning">API indisponible (status <%= data.listStatus %>)</div>
    <% } %>

    <div class="table-responsive">
      <table class="table table-borderless align-middle rocket-table">
        <thead>
          <% if (data.segment === 'login-history') { %>
            <tr>
              <th>Actor</th>
              <th>Action</th>
              <th>IP Address</th>
              <th>Date</th>
            </tr>
          <% } else if (data.segment === 'instructor-requests') { %>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Job Title</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          <% } else { %>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Department</th>
              <th>Job Title</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          <% } %>
        </thead>
        <tbody>
          <% if ((data.items ?? []).length === 0) { %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">No data available.</td>
            </tr>
          <% } %>
          <% (data.items ?? []).forEach((item) => { %>
            <% if (data.segment === 'login-history') { %>
              <tr>
                <td><%= item.actorUserId ?? '-' %></td>
                <td><%= item.action ?? '-' %></td>
                <td><%= item.ipAddress ?? '-' %></td>
                <td><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : '-' %></td>
              </tr>
            <% } else if (data.segment === 'instructor-requests') { %>
              <tr>
                <td><%= item.fullName ?? '-' %></td>
                <td><%= item.email ?? '-' %></td>
                <td><%= item.jobTitle ?? '-' %></td>
                <td><span class="badge text-bg-light"><%= item.status ?? '-' %></span></td>
                <td><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : '-' %></td>
                <td>
                  <form method="post" action="/admin/action/status" class="d-inline-flex gap-2">
                    <input type="hidden" name="path" value="users/become-instructors/instructors">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <select name="status" class="form-select form-select-sm">
                      <option value="APPROVED">APPROVED</option>
                      <option value="REJECTED">REJECTED</option>
                    </select>
                    <button class="btn btn-outline-primary btn-sm" type="submit">Mettre a jour</button>
                  </form>
                </td>
              </tr>
            <% } else { %>
              <tr>
                <td><%= item.fullName ?? '-' %></td>
                <td><%= item.email ?? '-' %></td>
                <td><%= item.department ?? '-' %></td>
                <td><%= item.jobTitle ?? '-' %></td>
                <td><span class="badge text-bg-light"><%= item.status ?? '-' %></span></td>
                <td><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : '-' %></td>
                <td>
                  <details class="position-relative d-inline-block">
                    <summary class="btn btn-light rounded-circle px-2 py-1 border-0">•••</summary>
                    <div class="dropdown-menu show position-absolute p-2" style="min-width: 160px; right: 0; left: auto;">
                      <a href="/admin/users/<%= item.id %>/edit" class="dropdown-item text-primary">Edit</a>
                      <form method="post" action="/admin/users/<%= item.id %>/delete" class="js-delete-user-form">
                        <button type="submit" class="dropdown-item text-danger">Delete</button>
                      </form>
                    </div>
                  </details>
                </td>
              </tr>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
      <small class="text-muted">Total: <%= data.total ?? 0 %> | Page <%= data.pageNumber ?? 1 %>/<%= data.totalPages ?? 1 %></small>
      <div class="d-flex gap-2">
        <% if ((data.pageNumber ?? 1) > 1) { %>
          <a class="btn btn-outline-secondary btn-sm" href="?page=<%= (data.pageNumber ?? 1) - 1 %>&pageSize=<%= data.pageSize ?? 10 %>&q=<%= encodeURIComponent(data.q ?? '') %>&status=<%= encodeURIComponent(data.status ?? '') %>">Previous</a>
        <% } %>
        <% if ((data.pageNumber ?? 1) < (data.totalPages ?? 1)) { %>
          <a class="btn btn-outline-secondary btn-sm" href="?page=<%= (data.pageNumber ?? 1) + 1 %>&pageSize=<%= data.pageSize ?? 10 %>&q=<%= encodeURIComponent(data.q ?? '') %>&status=<%= encodeURIComponent(data.status ?? '') %>">Next</a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/js/users-list.js"></script>
<% } %>
