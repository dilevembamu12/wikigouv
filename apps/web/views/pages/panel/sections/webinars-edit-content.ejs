        var sdate = safe((sroot.querySelector('.js-ss-inline-date') || {}).value || '');
        var sdurationRaw = safe((sroot.querySelector('.js-ss-inline-duration') || {}).value || '');
        var sextraTimeRaw = safe((sroot.querySelector('.js-ss-inline-extra-time-to-join') || {}).value || '');
        var sapiSecret = safe((sroot.querySelector('.js-ss-inline-api-secret') || {}).value || '');
        var smoderatorSecret = safe((sroot.querySelector('.js-ss-inline-moderator-secret') || {}).value || '');
        var slink = safe((sroot.querySelector('.js-ss-inline-link') || {}).value || '');
        var sdesc = safe((sroot.querySelector('.js-ss-inline-description') || {}).value || '');
        var sagoraChat = !!(sroot.querySelector('.js-ss-inline-agora-chat') || {}).checked;
        var sactiveEl = sroot.querySelector('.js-ss-inline-active');
        var sstatus = sactiveEl && sactiveEl.checked ? 'ACTIVE' : 'DRAFT';
        fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections/' + encodeURIComponent(sid), {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            type: 'session',
            title: stitle,
            status: sstatus,
            payload: {
              chapter_id: schapter,
              session_api: sprovider,
              api_secret: sapiSecret,
              moderator_secret: smoderatorSecret,
              date: sdate,
              duration: toNullableNumber(sdurationRaw),
              extra_time_to_join: toNullableNumber(sextraTimeRaw),
              link: slink,
              description: sdesc,
              agora_chat: sagoraChat
            }
          })
        }).then(function (r) { return r.json(); }).then(function (data) {
          if (!data.ok) throw new Error(getApiErrorMessage(data, 'Impossible de sauvegarder.'));
          refreshBuilder();
          if (hasSwal) Swal.fire({ icon: 'success', title: 'Session mise a jour' });
        }).catch(function (error) {
          if (hasSwal) Swal.fire({ icon: 'error', title: 'Echec de sauvegarde', text: (error && error.message) ? error.message : 'Merci de reessayer.' });
        });
        return;
      }
      var saveInlineAsBtn = event.target.closest('.js-save-as-inline');
      if (saveInlineAsBtn) {
        var aid = saveInlineAsBtn.getAttribute('data-id') || '';
        var aroot = saveInlineAsBtn.closest('.rocket-inline-item');
        if (!aroot || !aid) return;
        var atitle = safe((aroot.querySelector('.js-as-inline-title') || {}).value || '');
        var achapter = safe((aroot.querySelector('.js-as-inline-chapter') || {}).value || '');
        var agrade = safe((aroot.querySelector('.js-as-inline-grade') || {}).value || '');
        var apass = safe((aroot.querySelector('.js-as-inline-pass-grade') || {}).value || '');
        var adeadline = safe((aroot.querySelector('.js-as-inline-deadline') || {}).value || '');
        var aattempts = safe((aroot.querySelector('.js-as-inline-attempts') || {}).value || '');
        var adesc = safe((aroot.querySelector('.js-as-inline-description') || {}).value || '');
        var aactiveEl = aroot.querySelector('.js-as-inline-active');
        var astatus = aactiveEl && aactiveEl.checked ? 'ACTIVE' : 'DRAFT';
        fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections/' + encodeURIComponent(aid), {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            type: 'assignment',
            title: atitle,
            status: astatus,
            payload: {
              chapter_id: achapter,
              grade: toNullableNumber(agrade),
              pass_grade: toNullableNumber(apass),
              deadline: adeadline,
              attempts: toNullableNumber(aattempts),
              description: adesc
            }
          })
        }).then(function (r) { return r.json(); }).then(function (data) {
          if (!data.ok) throw new Error(getApiErrorMessage(data, 'Impossible de sauvegarder.'));
          refreshBuilder();
          if (hasSwal) Swal.fire({ icon: 'success', title: 'Assignment mis a jour' });
        }).catch(function (error) {
          if (hasSwal) Swal.fire({ icon: 'error', title: 'Echec de sauvegarde', text: (error && error.message) ? error.message : 'Merci de reessayer.' });
        });
        return;
      }
      var saveInlineQzBtn = event.target.closest('.js-save-qz-inline');
      if (saveInlineQzBtn) {
        var qid = saveInlineQzBtn.getAttribute('data-id') || '';
        var qroot = saveInlineQzBtn.closest('.rocket-inline-item');
        if (!qroot || !qid) return;
        var qtitle = safe((qroot.querySelector('.js-qz-inline-title') || {}).value || '');
        var qchapter = safe((qroot.querySelector('.js-qz-inline-chapter') || {}).value || '');
        var qtime = safe((qroot.querySelector('.js-qz-inline-time') || {}).value || '');
        var qattempt = safe((qroot.querySelector('.js-qz-inline-attempt') || {}).value || '');
        var qpass = safe((qroot.querySelector('.js-qz-inline-pass-mark') || {}).value || '');
        var qexpiry = safe((qroot.querySelector('.js-qz-inline-expiry-days') || {}).value || '');
        var qdescription = safe((qroot.querySelector('.js-qz-inline-description') || {}).value || '');
        var qrandom = !!(qroot.querySelector('.js-qz-inline-random') || {}).checked;
        var qcertificate = !!(qroot.querySelector('.js-qz-inline-certificate') || {}).checked;
        var qactive = !!(qroot.querySelector('.js-qz-inline-active') || {}).checked;
        var qstatus = qactive ? 'ACTIVE' : 'DRAFT';
        fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections/' + encodeURIComponent(qid), {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            type: 'quiz',
            title: qtitle,
            status: qstatus,
            payload: {
              chapter_id: qchapter,
              time: toNullableNumber(qtime),
              attempt: toNullableNumber(qattempt),
              pass_mark: toNullableNumber(qpass),
              expiry_days: toNullableNumber(qexpiry),
              description: qdescription,
              display_questions_randomly: qrandom,
              certificate: qcertificate
            }
          })
        }).then(function (r) { return r.json(); }).then(function (data) {
          if (!data.ok) throw new Error(getApiErrorMessage(data, 'Impossible de sauvegarder.'));
          refreshBuilder();
          if (hasSwal) Swal.fire({ icon: 'success', title: 'Quiz mis a jour' });
        }).catch(function (error) {
          if (hasSwal) Swal.fire({ icon: 'error', title: 'Echec de sauvegarde', text: (error && error.message) ? error.message : 'Merci de reessayer.' });
        });
        return;
      }

      var addInChapter = event.target.closest('.js-add-in-chapter');
      if (addInChapter) {
        var directType = addInChapter.getAttribute('data-type') || '';
        var directLabel = addInChapter.getAttribute('data-label') || directType;
        var directChapterId = addInChapter.getAttribute('data-chapter-id') || '';
        buildCreateModal(directType, directLabel, directChapterId).then(function (result) {
          if (!result.isConfirmed) return;
          createSectionItem(directType, result.value, directChapterId);
        });
        return;
      }

      var quickAddBtn = event.target.closest('.js-chapter-add');
      if (quickAddBtn) {
        var chapterId = quickAddBtn.getAttribute('data-id');
        var existing = document.getElementById('rocketChapterQuickMenu');
        if (existing) existing.remove();
        var menu = document.createElement('div');
        menu.id = 'rocketChapterQuickMenu';
        menu.className = 'rocket-quick-menu';
        menu.setAttribute('data-chapter-id', chapterId || '');
        menu.innerHTML = [
          '<button type="button" class="js-quick-add-option" data-type="file">Add File</button>',
          '<button type="button" class="js-quick-add-option" data-type="interactive_file">New SCORM File</button>',
          '<button type="button" class="js-quick-add-option" data-type="text_lesson">Add Text Lesson</button>',
          '<button type="button" class="js-quick-add-option" data-type="quiz">Add Quiz</button>',
          '<button type="button" class="js-quick-add-option" data-type="assignment">Add Assignment</button>'
        ].join('');
        document.body.appendChild(menu);
        var rect = quickAddBtn.getBoundingClientRect();
        menu.style.left = (window.scrollX + rect.left - 6) + 'px';
        menu.style.top = (window.scrollY + rect.bottom + 6) + 'px';
        return;
      }

      var chapterToggleBtn = event.target.closest('.js-chapter-toggle');
      if (chapterToggleBtn) {
        var chapterToggleId = chapterToggleBtn.getAttribute('data-id') || '';
        var chapterBody = document.querySelector('[data-chapter-body="' + chapterToggleId.replace(/"/g, '\\"') + '"]');
        var icon = chapterToggleBtn.querySelector('i');
        if (chapterBody) {
          chapterBody.classList.toggle('d-none');
          if (icon) {
            icon.classList.toggle('fa-angle-up', !chapterBody.classList.contains('d-none'));
            icon.classList.toggle('fa-angle-down', chapterBody.classList.contains('d-none'));
          }
        }
        return;
      }

      var quickAddOption = event.target.closest('.js-quick-add-option');
      if (quickAddOption) {
        var addType = quickAddOption.getAttribute('data-type') || 'file';
        var menuEl = document.getElementById('rocketChapterQuickMenu');
        var chapterIdFromMenu = menuEl ? (menuEl.getAttribute('data-chapter-id') || '') : '';
        if (menuEl) menuEl.remove();
        buildCreateModal(addType, (typeSchemas[addType] && addType) || addType, chapterIdFromMenu).then(function (result) {
          if (!result.isConfirmed) return;
          createSectionItem(addType, result.value, chapterIdFromMenu);
        });
        return;
      }

      var inlineToggleBtn = event.target.closest('.js-inline-toggle');
      if (inlineToggleBtn) {
        var inlineRoot = inlineToggleBtn.closest('.rocket-file-inline, .rocket-inline-item');
        if (!inlineRoot) return;
        var inlineBody = inlineRoot.querySelector('.rocket-file-inline-body, .rocket-inline-item-body');
        if (!inlineBody) return;
        inlineBody.classList.toggle('d-none');
        inlineToggleBtn.classList.toggle('is-collapsed', inlineBody.classList.contains('d-none'));
        return;
      }

      var editBtn = event.target.closest('.js-edit-item');
      if (editBtn) {
        var type = editBtn.getAttribute('data-type');
        var itemId = editBtn.getAttribute('data-id');
        var sectionItems = sectionItemsByType[type] || [];
        var item = sectionItems.find(function (x) { return safe(x.id) === safe(itemId); }) || {
          id: itemId,
          title: editBtn.getAttribute('data-title') || '',
          status: editBtn.getAttribute('data-status') || 'ACTIVE',
          payload: {}
        };
        buildEditModal(type, item).then(function (result) {
          if (!result.isConfirmed) return;
          fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections/' + encodeURIComponent(itemId), {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(result.value)
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (!data.ok) throw new Error(getApiErrorMessage(data, 'Impossible de mettre a jour cet element.'));
              refreshBuilder();
              if (hasSwal) Swal.fire({ icon: 'success', title: 'Mise a jour effectuee' });
            })
            .catch(function (error) {
              if (hasSwal) Swal.fire({ icon: 'error', title: 'Echec de la mise a jour', text: (error && error.message) ? error.message : 'Merci de reessayer.' });
            });
        });
        return;
      }

      var deleteBtn = event.target.closest('.js-delete-item');
      if (deleteBtn) {
        var delType = deleteBtn.getAttribute('data-type');
        var delId = deleteBtn.getAttribute('data-id');
        if (!hasSwal) {
          if (!window.confirm('Delete this item?')) return;
          fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections/' + encodeURIComponent(delId) + '/delete', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ type: delType })
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (!data.ok) throw new Error('delete_error');
              refreshBuilder();
            })
            .catch(function () {});
          return;
        }
        Swal.fire({
          icon: 'warning',
          title: 'Delete this item?',
          showCancelButton: true,
          confirmButtonText: 'Delete'
        }).then(function (res) {
          if (!res.isConfirmed) return;
          fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections/' + encodeURIComponent(delId) + '/delete', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ type: delType })
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (!data.ok) throw new Error('delete_error');
              refreshBuilder();
              if (hasSwal) Swal.fire({ icon: 'success', title: 'Deleted' });
            })
            .catch(function () { if (hasSwal) Swal.fire({ icon: 'error', title: 'Delete failed' }); });
        });
      }
    });

    document.getElementById('builderSections').addEventListener('change', function (event) {
      var sourceEl = event.target.closest('.js-file-inline-source');
      if (sourceEl) {
        var sourceRoot = sourceEl.closest('.rocket-file-inline');
        applyInlineFileSourceBehavior(sourceRoot);
      }
      var dripEl = event.target.closest('.js-file-inline-drip');
      if (dripEl) {
        var dripRoot = dripEl.closest('.rocket-file-inline');
        applyInlineFileDripBehavior(dripRoot);
      }
      var ssProviderEl = event.target.closest('.js-ss-inline-provider');
      if (ssProviderEl) {
        var ssRoot = ssProviderEl.closest('.rocket-inline-item');
        applyInlineSessionProviderBehavior(ssRoot);
      }
      var ifTypeEl = event.target.closest('.js-if-inline-type');
      if (ifTypeEl) {
        var ifTypeRoot = ifTypeEl.closest('.rocket-inline-item');
        applyInlineInteractiveTypeBehavior(ifTypeRoot);
      }
      var deviceFileInput = event.target.closest('.js-file-inline-device-file');
      if (deviceFileInput) {
        var fileRoot = deviceFileInput.closest('.rocket-file-inline');
        if (!fileRoot) return;
        var file = deviceFileInput.files && deviceFileInput.files[0] ? deviceFileInput.files[0] : null;
        var sourceEl2 = fileRoot.querySelector('.js-file-inline-source');
        var src2 = safe((sourceEl2 && sourceEl2.value) || 'upload').toLowerCase();
        if (!file) return;
        if (src2 === 'upload' || src2 === 's3' || src2 === 'secure_host') {
          uploadInlineLocalFile(fileRoot, file);
        } else {
          var pathInput = fileRoot.querySelector('.js-file-inline-path');
          if (pathInput) {
            pathInput.value = file.name;
            pathInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
      }

      var ifDeviceFileInput = event.target.closest('.js-if-inline-device-file');
      if (ifDeviceFileInput) {
        var ifFileRoot = ifDeviceFileInput.closest('.rocket-inline-item');
        if (!ifFileRoot) return;
        var ifPathInput = ifFileRoot.querySelector('.js-if-inline-path');
        var ifFile = ifDeviceFileInput.files && ifDeviceFileInput.files[0] ? ifDeviceFileInput.files[0] : null;
        if (!ifFile || !ifPathInput) return;
        var safeCourseFolder2 = String(webinarId || 'general').replace(/[^a-zA-Z0-9_-]/g, '_');
        uploadModalFile(ifPathInput.id, ifFile, 'Library/courses/scorm/' + safeCourseFolder2, function () {
          ifDeviceFileInput.value = '';
        });
      }
    });

    document.addEventListener('click', function (event) {
      var menu = document.getElementById('rocketChapterQuickMenu');
      if (!menu) return;
      if (event.target.closest('#rocketChapterQuickMenu') || event.target.closest('.js-chapter-add')) return;
      menu.remove();
    });

    window.addEventListener('message', function (event) {
      if (!event || event.origin !== window.location.origin) return;
      var data = event.data || {};
      if (data.type !== 'LIBRARY_FILE_SELECTED') return;
      var targetInputId = safe(data.target || '');
      var selectedKey = safe(data.key || '');
      if (!targetInputId || !selectedKey) return;
      var targetInput = document.getElementById(targetInputId);
      if (!targetInput) return;
      targetInput.value = selectedKey;
      targetInput.dispatchEvent(new Event('input', { bubbles: true }));
      if (hasSwal) Swal.fire({ icon: 'success', title: 'Fichier selectionne', text: 'Le chemin a ete injecte dans le formulaire.' });
    });
  })();
</script>
