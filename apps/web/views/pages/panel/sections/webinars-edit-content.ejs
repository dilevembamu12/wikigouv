    function previewLibraryFile(targetInputId) {
      if (!targetInputId) return;
      var input = document.getElementById(targetInputId);
      if (!input) return;
      var key = safe(input.value).trim();
      if (!key) {
        if (hasSwal) Swal.fire({ icon: 'info', title: 'Aucun fichier', text: 'Selectionnez d abord un fichier dans la Library.' });
        return;
      }
      fetch('/admin/library/presign?key=' + encodeURIComponent(key))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var previewUrl = data && data.previewUrl ? data.previewUrl : '';
          if (!previewUrl) throw new Error('Impossible de generer l apercu pour ce fichier.');
          window.open(previewUrl, '_blank', 'noopener');
        })
        .catch(function (error) {
          if (hasSwal) Swal.fire({ icon: 'error', title: 'Preview indisponible', text: (error && error.message) ? error.message : 'Merci de reessayer.' });
