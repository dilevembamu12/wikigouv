    function attachInlineRichEditor(textarea) {
      if (!textarea || textarea.dataset.richifiedInline === '1') return;
      textarea.dataset.richifiedInline = '1';
      textarea.style.display = 'none';

      var box = document.createElement('div');
      box.className = 'rocket-rich mt-1';
      var toolbar = document.createElement('div');
      toolbar.className = 'rocket-rich-toolbar';
      toolbar.innerHTML =
        '<button type="button" class="rocket-rich-btn" data-cmd="bold"><b>B</b></button>' +
        '<button type="button" class="rocket-rich-btn" data-cmd="italic"><i>I</i></button>' +
        '<button type="button" class="rocket-rich-btn" data-cmd="insertUnorderedList"><i class="fa-solid fa-list-ul"></i></button>' +
        '<button type="button" class="rocket-rich-btn" data-cmd="insertOrderedList"><i class="fa-solid fa-list-ol"></i></button>' +
        '<button type="button" class="rocket-rich-btn" data-cmd="createLink"><i class="fa-solid fa-link"></i></button>';
      var editor = document.createElement('div');
      editor.className = 'rocket-rich-editor';
      editor.contentEditable = 'true';
      editor.dataset.placeholder = textarea.getAttribute('placeholder') || 'Write content...';
      editor.innerHTML = textarea.value || '';
      box.appendChild(toolbar);
      box.appendChild(editor);
      textarea.parentNode.insertBefore(box, textarea.nextSibling);

      toolbar.addEventListener('click', function (ev) {
        var btn = ev.target.closest('.rocket-rich-btn');
        if (!btn) return;
        var cmd = btn.getAttribute('data-cmd');
        if (!cmd) return;
        editor.focus();
        if (cmd === 'createLink') {
          var url = window.prompt('Enter URL');
          if (!url) return;
          document.execCommand(cmd, false, url);
        } else {
          document.execCommand(cmd, false, null);
        }
        textarea.value = editor.innerHTML;
      });

      editor.addEventListener('input', function () {
        textarea.value = editor.innerHTML;
      });
    }

    function enhanceInlineRichEditors() {
      var selectors = [
        '.js-file-inline-description',
        '.js-if-inline-description',
        '.js-tl-inline-summary',
        '.js-tl-inline-content',
        '.js-ss-inline-description',
        '.js-as-inline-description',
        '.js-qz-inline-description'
      ];
      selectors.forEach(function (selector) {
        document.querySelectorAll(selector).forEach(function (textarea) {
          attachInlineRichEditor(textarea);
        });
      });
    }

    function buildCreateModal(type, label, chapterContextId) {
      if (!hasSwal) {
        window.alert('Le composant modal SweetAlert est indisponible. Rechargez la page.');
        return Promise.resolve({ isConfirmed: false });
      }
      var schema = typeSchemas[type] || { statusDefault: 'ACTIVE', fields: [] };
      var statusOptions = ['ACTIVE', 'INACTIVE', 'DRAFT', 'PUBLISHED', 'ARCHIVED'];
      var statusDefault = schema.statusDefault || 'ACTIVE';
      var html = '<div class="rocket-modal-grid">' +
        '<div class="rocket-modal-field mb-2"><label class="swal2-label">Title</label><input id="sw-title" class="swal2-input" placeholder="Title"></div>' +
        '<div class="rocket-modal-field mb-2"><label class="swal2-label">Status</label><select id="sw-status" class="swal2-select">' +
          statusOptions.map(function (status) {
            return '<option value="' + status + '"' + (status === statusDefault ? ' selected' : '') + '>' + status + '</option>';
          }).join('') +
        '</select></div>';
      html += (schema.fields || []).map(function (field) { return fieldHtml(type, field); }).join('');
      html += '</div>';
      return Swal.fire({
        title: 'Add ' + label,
        html: html,
        width: 760,
        customClass: {
          popup: 'rocket-swal-popup',
          title: 'rocket-swal-title',
          confirmButton: 'btn btn-primary',
          cancelButton: 'btn btn-danger ms-2'
        },
        buttonsStyling: false,
        allowEnterKey: false,
        allowEscapeKey: function () { return modalUploadInProgressCount === 0; },
        allowOutsideClick: function () { return modalUploadInProgressCount === 0; },
        focusConfirm: false,
        showCancelButton: true,
        confirmButtonText: 'Save',
        cancelButtonText: 'Close',
        didOpen: function () {
          enhanceSectionSelect(type, safe(chapterContextId || ''), safe(chapterContextId || '') !== '');
          if (type === 'text_lesson') enhanceTextLessonModalUX();
          if (type === 'text_lesson') enhanceTextLessonAttachmentsPicker();
          if (type === 'prerequisite') enhanceCourseSearchSelect(type, 'prerequisite_id', '');
          if (type === 'related_course') enhanceCourseSearchSelect(type, 'related_course_id', '');
          bindDynamicRules(type);
          bindModalFileControls(type);
          enhanceModalSelectFilter(type);
          enhanceModalRichText(type);
        },
        preConfirm: function () {
          if (!guardModalConfirmWhileUploading()) return false;
          var payload = {};
          (schema.fields || []).forEach(function (field) {
            var el = document.getElementById('sw_' + type + '_' + field.key);
            if (!el) return;
            if (field.type === 'checkbox') {
              payload[field.key] = !!el.checked;
            } else if (field.type === 'number') {
              payload[field.key] = el.value === '' ? null : Number(el.value);
            } else if (field.key === 'attachments') {
              var raw = String(el.value || '').trim();
              if (!raw) payload[field.key] = [];
              else {
                try { payload[field.key] = JSON.parse(raw); } catch (_) { payload[field.key] = raw; }
              }
            } else {
              payload[field.key] = el.value;
            }
          });
          if (safe(chapterContextId || '') !== '') {
            var hasChapterField = (schema.fields || []).some(function (field) {
              return field && field.key === 'chapter_id';
            });
            if (hasChapterField) {
              payload.chapter_id = safe(chapterContextId || '');
            }
          }
          var modalTitle = document.getElementById('sw-title').value;
          var requiredMessage = validateRequiredModalFields(type, modalTitle, payload);
          if (requiredMessage) {
            Swal.showValidationMessage(requiredMessage);
            return false;
          }
          return {
            title: modalTitle,
            status: document.getElementById('sw-status').value || statusDefault,
            payload: payload
          };
        }
      });
    }

    function buildEditModal(type, item) {
      if (!hasSwal) {
        window.alert('Le composant modal SweetAlert est indisponible. Rechargez la page.');
        return Promise.resolve({ isConfirmed: false });
      }
      var schema = typeSchemas[type] || { statusDefault: 'ACTIVE', fields: [] };
      var statusOptions = ['ACTIVE', 'INACTIVE', 'DRAFT', 'PUBLISHED', 'ARCHIVED'];
      var statusValue = item && item.status ? item.status : (schema.statusDefault || 'ACTIVE');
      var payload = item && typeof item.payload === 'object' && item.payload ? item.payload : {};
      var html = '<div class="rocket-modal-grid">' +
        '<div class="rocket-modal-field mb-2"><label class="swal2-label">Title</label><input id="sw-title" class="swal2-input" value="' + escapeHtml(item && item.title ? item.title : '') + '"></div>' +
        '<div class="rocket-modal-field mb-2"><label class="swal2-label">Status</label><select id="sw-status" class="swal2-select">' +
          statusOptions.map(function (status) {
            return '<option value="' + status + '"' + (status === statusValue ? ' selected' : '') + '>' + status + '</option>';
          }).join('') +
        '</select></div>';

      html += (schema.fields || []).map(function (field) {
        var localField = Object.assign({}, field);
        localField.defaultValue = type === 'quiz' && field.key === 'pass_mark'
          ? (item && item.passingScore != null ? item.passingScore : (payload.pass_mark || 70))
          : payload[field.key];
        return fieldHtml(type, localField);
      }).join('');
      html += '</div>';

      return Swal.fire({
        title: 'Edit item',
        html: html,
        width: 760,
        customClass: {
          popup: 'rocket-swal-popup',
          title: 'rocket-swal-title',
          confirmButton: 'btn btn-primary',
          cancelButton: 'btn btn-danger ms-2'
        },
        buttonsStyling: false,
        allowEnterKey: false,
        allowEscapeKey: function () { return modalUploadInProgressCount === 0; },
        allowOutsideClick: function () { return modalUploadInProgressCount === 0; },
        focusConfirm: false,
        showCancelButton: true,
        confirmButtonText: 'Update',
        cancelButtonText: 'Cancel',
        didOpen: function () {
          enhanceSectionSelect(type, payload.chapter_id);
          if (type === 'text_lesson') enhanceTextLessonModalUX();
          if (type === 'text_lesson') enhanceTextLessonAttachmentsPicker();
          if (type === 'prerequisite') enhanceCourseSearchSelect(type, 'prerequisite_id', payload.prerequisite_id);
          if (type === 'related_course') enhanceCourseSearchSelect(type, 'related_course_id', payload.related_course_id);
          bindDynamicRules(type);
          bindModalFileControls(type);
          enhanceModalSelectFilter(type);
          enhanceModalRichText(type);
        },
        preConfirm: function () {
          if (!guardModalConfirmWhileUploading()) return false;
          var outPayload = {};
          (schema.fields || []).forEach(function (field) {
            var el = document.getElementById('sw_' + type + '_' + field.key);
            if (!el) return;
            if (field.type === 'checkbox') outPayload[field.key] = !!el.checked;
            else if (field.type === 'number') outPayload[field.key] = el.value === '' ? null : Number(el.value);
            else if (field.key === 'attachments') {
              var raw = String(el.value || '').trim();
              if (!raw) outPayload[field.key] = [];
              else {
                try { outPayload[field.key] = JSON.parse(raw); } catch (_) { outPayload[field.key] = raw; }
              }
            } else outPayload[field.key] = el.value;
          });
          var modalTitle = document.getElementById('sw-title').value;
          var requiredMessage = validateRequiredModalFields(type, modalTitle, outPayload);
          if (requiredMessage) {
            Swal.showValidationMessage(requiredMessage);
            return false;
          }
          return {
            type: type,
            title: modalTitle,
            status: document.getElementById('sw-status').value || statusValue,
            payload: outPayload
          };
        }
      });
    }

    function statusBadge(status) {
      var s = safe(status || 'ACTIVE').toUpperCase();
      return '<span class="rocket-badge-status">' + s + '</span>';
    }

    function renderEmptyState(type) {
      var emptyMap = {
        chapter: 'No Sections!',
        file: 'No Files!',
        interactive_file: 'No SCORM Files!',
        text_lesson: 'No Text Lessons!',
        session: 'No Live Sessions!',
        assignment: 'No Assignments!',
        prerequisite: 'No Prerequisites defined!',
        related_course: 'No Related Courses Selected!',
        faq: 'No FAQs Available!',
        learning_material: 'No Learning Materials!',
        company_logo: 'No Company Logos!',
        requirement: 'No Requirements!',
        quiz: 'No Quiz Created for This Course!',
        pricing_plan: 'No Pricing Plans Found!'
      };
      return '<div class="rocket-empty-state">' +
        '<span class="icon-wrap"><i class="fa-regular fa-folder-open fs-4"></i></span>' +
        '<div class="title">' + (emptyMap[type] || 'No items yet.') + '</div>' +
        '<div class="sub">You can add content to your course for students.</div>' +
      '</div>';
    }

    function itemBelongsToChapter(item, chapterId) {
      if (!item || typeof item !== 'object') return false;
      var payload = item.payload && typeof item.payload === 'object' ? item.payload : {};
      var pChapterId = payload.chapter_id || payload.chapterId || item.chapter_id || item.chapterId || '';
      return safe(pChapterId) === safe(chapterId);
    }

    function renderSectionBlock(chapterId, group) {
      var items = (sectionItemsByType[group.key] || []).filter(function (item) {
        return itemBelongsToChapter(item, chapterId);
      });
      return (
        '<section class="rocket-group-shell">' +
          '<div class="rocket-group-header">' +
            '<h4 class="rocket-group-title">' + group.label + '</h4>' +
            '<button type="button" class="btn btn-primary btn-sm rocket-add-btn js-add-in-chapter" data-type="' + group.key + '" data-label="' + group.label + '" data-chapter-id="' + safe(chapterId) + '">' + escapeHtml(group.addLabel || 'Add') + '</button>' +
          '</div>' +
          '<div class="rocket-group-body">' +
            (items.length ? items.map(function (item) { return renderItem(item, group.key); }).join('') : renderEmptyState(group.key)) +
          '</div>' +
        '</section>'
      );
    }

    function renderChapterBoard() {
      var chapters = sectionItemsByType.chapter || [];
      var hasGeneralItems = sectionGroups.some(function (group) {
        var items = sectionItemsByType[group.key] || [];
        return items.some(function (item) { return itemBelongsToChapter(item, ''); });
      });
      if (!chapters.length && !hasGeneralItems) {
        builderSections.innerHTML = renderEmptyState('chapter');
        return;
      }
      var generalBoardHtml = '';
      if (hasGeneralItems) {
        var generalTopicCount = sectionGroups.reduce(function (acc, group) {
          var items = (sectionItemsByType[group.key] || []).filter(function (item) {
            return itemBelongsToChapter(item, '');
          });
          return acc + items.length;
        }, 0);
        generalBoardHtml =
          '<div class="rocket-builder-card border rounded p-3 mb-4" data-chapter-id="">' +
            '<div class="rocket-chapter-row d-flex justify-content-between align-items-center">' +
              '<div class="d-flex align-items-center">' +
                '<span class="rocket-chapter-icon"><i class="fa-solid fa-layer-group"></i></span>' +
                '<div>' +
                  '<div class="rocket-item-title">Contenu general / Intro</div>' +
                  '<div class="rocket-item-meta">' + generalTopicCount + ' Topic | 0 Hr</div>' +
                '</div>' +
              '</div>' +
              '<div class="rocket-row-actions">' +
                '<button type="button" class="rocket-icon-btn plus js-chapter-add" data-id="" title="Add content">+</button>' +
                '<button type="button" class="rocket-icon-btn js-chapter-toggle" data-id="general-intro" title="Collapse"><i class="fa-solid fa-angle-up"></i></button>' +
              '</div>' +
            '</div>' +
            '<div class="rocket-chapter-body" data-chapter-body="general-intro">' +
              sectionGroups.map(function (group) { return renderSectionBlock('', group); }).join('') +
            '</div>' +
          '</div>';
      }

      var chapterBoardsHtml = chapters.map(function (chapter, index) {
        var topicCount = sectionGroups.reduce(function (acc, group) {
          var items = (sectionItemsByType[group.key] || []).filter(function (item) {
            return itemBelongsToChapter(item, chapter.id);
          });
          return acc + items.length;
        }, 0);
        return (
          '<div class="rocket-builder-card border rounded p-3 mb-4" data-chapter-id="' + safe(chapter.id) + '">' +
            '<div class="rocket-chapter-row d-flex justify-content-between align-items-center">' +
              '<div class="d-flex align-items-center">' +
                '<span class="rocket-chapter-icon"><i class="fa-solid fa-grip"></i></span>' +
                '<div>' +
                  '<div class="rocket-item-title">' + safe(chapter.title || ('Section ' + (index + 1))) + '</div>' +
                  '<div class="rocket-item-meta">' + topicCount + ' Topic | 0 Hr</div>' +
                '</div>' +
              '</div>' +
              '<div class="rocket-row-actions">' +
                '<button type="button" class="rocket-icon-btn plus js-chapter-add" data-id="' + safe(chapter.id) + '" title="Add content">+</button>' +
                '<button type="button" class="rocket-icon-btn js-edit-item" data-type="chapter" data-id="' + safe(chapter.id) + '" data-title="' + safe(chapter.title || '').replace(/"/g, '&quot;') + '" data-status="' + safe(chapter.status || 'ACTIVE') + '" title="Edit"><i class="fa-solid fa-pen"></i></button>' +
                '<button type="button" class="rocket-icon-btn js-delete-item" data-type="chapter" data-id="' + safe(chapter.id) + '" title="Delete"><i class="fa-regular fa-trash-can"></i></button>' +
                '<button type="button" class="rocket-icon-btn" title="Sort"><i class="fa-solid fa-up-down-left-right"></i></button>' +
                '<button type="button" class="rocket-icon-btn js-chapter-toggle" data-id="' + safe(chapter.id) + '" title="Collapse"><i class="fa-solid fa-angle-up"></i></button>' +
              '</div>' +
            '</div>' +
            '<div class="rocket-chapter-body" data-chapter-body="' + safe(chapter.id) + '">' +
              sectionGroups.map(function (group) { return renderSectionBlock(chapter.id, group); }).join('') +
            '</div>' +
          '</div>'
        );
      }).join('');

      builderSections.innerHTML = generalBoardHtml + chapterBoardsHtml;
    }

    function renderItem(item, type) {
      var id = safe(item.id);
      var title = safe(item.title || item.subject || 'Untitled');
      var status = safe(item.status || 'ACTIVE');
      var payload = item.payload || {};
      if (type === 'file') {
        return renderFileInlineItem(item, id, title, status, payload);
      }
      if (type === 'interactive_file') {
        return renderInteractiveInlineItem(item, id, title, status, payload);
      }
      if (type === 'text_lesson') {
        return renderTextLessonInlineItem(item, id, title, status, payload);
      }
      if (type === 'session') {
        return renderSessionInlineItem(item, id, title, status, payload);
      }
      if (type === 'assignment') {
        return renderAssignmentInlineItem(item, id, title, status, payload);
      }
      if (type === 'quiz') {
        return renderQuizInlineItem(item, id, title, status, payload);
      }
      var details = [];
      Object.keys(payload).slice(0, 3).forEach(function (k) {
        details.push(k + ': ' + safe(payload[k]));
      });

      return (
        '<div class="rocket-item-row d-flex justify-content-between align-items-start" data-id="' + id + '">' +
          '<div>' +
            '<div class="rocket-item-title">' + title + statusBadge(status) + '</div>' +
            '<div class="rocket-item-meta">' + (details.length ? details.join(' | ') : 'Ready to configure') + '</div>' +
          '</div>' +
          '<div class="d-flex gap-2">' +
            '<button class="btn btn-outline-secondary btn-sm js-edit-item" data-type="' + type + '" data-id="' + id + '" data-title="' + title.replace(/"/g, '&quot;') + '" data-status="' + status + '">Edit</button>' +
            (type !== 'quiz'
              ? '<button class="btn btn-outline-danger btn-sm js-delete-item" data-type="' + type + '" data-id="' + id + '">Delete</button>'
              : '') +
          '</div>' +
        '</div>'
      );
    }

    function renderFileInlineItem(item, id, title, status, payload) {
      var chapters = sectionItemsByType.chapter || [];
      var chapterId = safe(payload.chapter_id || payload.chapterId || '');
      var chapterOptions = chapters.map(function (ch) {
        var chId = safe(ch.id);
        return '<option value="' + chId + '"' + (chId === chapterId ? ' selected' : '') + '>' + escapeHtml(safe(ch.title || 'Section')) + '</option>';
      }).join('');
      var source = safe(payload.storage || 'upload');
      var accessibility = safe(payload.accessibility || 'free');
      var filePath = safe(payload.file_path || '');
      var description = safe(payload.description || '');
      var fileType = safe(payload.file_type || '');
      var fileVolume = safe(payload.volume || '');
      var onlineViewerChecked = payload.online_viewer ? ' checked' : '';
      var downloadableChecked = payload.downloadable ? ' checked' : '';
