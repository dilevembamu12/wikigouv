    function openLibraryPickerForInput(inputId) {
      if (!inputId) return;
      openLibraryPicker(inputId);
    }

    function previewFromInput(inputId) {
      if (!inputId) return;
      previewLibraryFile(inputId);
    }

    function uploadModalFile(inputId, file, folder, done) {
      if (!inputId || !file) return;
      var input = document.getElementById(inputId);
      if (!input) return;
      var row = input.closest('.rocket-modal-field');
      var statusEl = row ? row.querySelector('.js-modal-upload-status') : null;
      if (statusEl) {
        statusEl.textContent = 'Upload en cours...';
        statusEl.classList.remove('text-danger', 'text-success');
        statusEl.classList.add('text-muted');
      }
      modalUploadInProgressCount += 1;
      input.disabled = true;
      var form = new FormData();
      form.append('file', file);
      form.append('folder', folder || 'Library/courses/uploads');
      fetch('/admin/library/upload', { method: 'POST', body: form })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || data.ok === false || !data.key) {
            throw new Error(getApiErrorMessage(data, 'Upload impossible pour ce fichier.'));
          }
          var chosenKey = safe(data.scormEntryKey || data.key);
          input.value = chosenKey;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          if (safe(data.scormIndexFile)) {
            var scormIdx = document.getElementById('sw_interactive_file_interactive_file_name');
            if (scormIdx && !safe(scormIdx.value).trim()) {
              scormIdx.value = safe(data.scormIndexFile);
            }
          }
          if (statusEl) {
            if (safe(data.scormExtractError)) {
              statusEl.textContent = 'Upload termine, mais extraction SCORM en echec: ' + safe(data.scormExtractError);
              statusEl.classList.remove('text-muted', 'text-success');
              statusEl.classList.add('text-danger');
            } else {
              statusEl.textContent = safe(data.scormEntryKey)
                ? 'Upload + extraction SCORM termines.'
                : 'Upload termine. Le chemin a ete rempli.';
              statusEl.classList.remove('text-muted', 'text-danger');
              statusEl.classList.add('text-success');
            }
          }
        })
        .catch(function (error) {
          var msg = (error && error.message) ? error.message : 'Merci de reessayer.';
          if (statusEl) {
            statusEl.textContent = 'Upload echoue: ' + msg;
            statusEl.classList.remove('text-muted', 'text-success');
            statusEl.classList.add('text-danger');
          }
          if (hasSwal && typeof Swal.isVisible === 'function' && Swal.isVisible()) {
            Swal.showValidationMessage('Upload echoue: ' + msg);
          } else if (hasSwal) {
            Swal.fire({ icon: 'error', title: 'Upload echec', text: msg });
          }
        })
        .finally(function () {
          modalUploadInProgressCount = Math.max(0, modalUploadInProgressCount - 1);
          input.disabled = false;
          if (typeof done === 'function') done();
        });
    }

    function bindModalFileControls(type) {
      function bindFieldControls(fieldKey, opts) {
        var input = document.getElementById('sw_' + type + '_' + fieldKey);
        if (!input || input.dataset.bindReady === '1') return;
        input.dataset.bindReady = '1';

        var row = input.closest('.rocket-modal-field');
        if (!row) return;
        var controls = document.createElement('div');
        controls.className = 'd-flex align-items-center gap-2 mt-2';
        controls.innerHTML = '' +
          '<button type="button" class="btn btn-outline-secondary btn-sm js-modal-lib-btn">Library</button>' +
          '<button type="button" class="btn btn-outline-primary btn-sm js-modal-preview-btn"><i class="fa-regular fa-eye"></i></button>' +
          '<button type="button" class="btn btn-outline-secondary btn-sm js-modal-browse-btn">Browse</button>' +
          '<input type="file" class="d-none js-modal-file-input"' + (opts && opts.accept ? (' accept="' + opts.accept + '"') : '') + '>' +
          '<span class="small text-muted js-modal-upload-status"></span>';
        row.appendChild(controls);

        var libBtn = controls.querySelector('.js-modal-lib-btn');
        var previewBtn = controls.querySelector('.js-modal-preview-btn');
        var browseBtn = controls.querySelector('.js-modal-browse-btn');
        var fileInput = controls.querySelector('.js-modal-file-input');
        var sourceEl = document.getElementById('sw_' + type + '_storage');

        function computeFolder() {
          var safeCourseFolder = String(webinarId || 'general').replace(/[^a-zA-Z0-9_-]/g, '_');
          if (opts && opts.fixedFolder) return opts.fixedFolder + '/' + safeCourseFolder;
          var src = sourceEl ? safe(sourceEl.value).toLowerCase() : 'upload';
          if (type === 'interactive_file') return 'Library/courses/scorm/' + safeCourseFolder;
          return ((src === 's3' || src === 'secure_host') ? 'Library/courses/s3/' : 'Library/courses/uploads/') + safeCourseFolder;
        }

        function updateBrowseVisibility() {
          if (opts && opts.alwaysBrowse) {
            if (browseBtn) browseBtn.classList.remove('d-none');
            return;
          }
          var src = sourceEl ? safe(sourceEl.value).toLowerCase() : 'upload';
          var showBrowse = (type === 'interactive_file') || src === 'upload' || src === 's3' || src === 'secure_host';
          if (browseBtn) browseBtn.classList.toggle('d-none', !showBrowse);
        }

        if (libBtn) libBtn.addEventListener('click', function () { openLibraryPickerForInput(input.id); });
        if (previewBtn) previewBtn.addEventListener('click', function () { previewFromInput(input.id); });
        if (browseBtn && fileInput) {
          browseBtn.addEventListener('click', function () { fileInput.click(); });
          fileInput.addEventListener('change', function () {
            var file = fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
            if (!file) return;
            uploadModalFile(input.id, file, computeFolder(), function () {
              fileInput.value = '';
            });
          });
        }
        if (sourceEl) sourceEl.addEventListener('change', updateBrowseVisibility);
        updateBrowseVisibility();
      }

      bindFieldControls('file_path');
      if (type === 'text_lesson') {
        bindFieldControls('image', {
          alwaysBrowse: true,
          fixedFolder: 'Library/courses/images',
          accept: 'image/*'
        });
      }
    }

    function guardModalConfirmWhileUploading() {
      if (modalUploadInProgressCount > 0) {
        if (hasSwal) Swal.showValidationMessage('Upload en cours... veuillez patienter avant de sauvegarder.');
        return false;
      }
      return true;
    }

    function setInlineFileUploading(root, isUploading, label) {
      if (!root) return;
      var saveBtn = root.querySelector('.js-save-file-inline');
      var browseBtn = root.querySelector('.js-file-inline-browse');
      var help = root.querySelector('.js-file-inline-path-help');
      if (saveBtn) {
        if (!saveBtn.dataset.defaultText) saveBtn.dataset.defaultText = saveBtn.textContent || 'Save';
        saveBtn.disabled = !!isUploading;
        saveBtn.textContent = isUploading ? (label || 'Uploading...') : saveBtn.dataset.defaultText;
      }
      if (browseBtn) browseBtn.disabled = !!isUploading;
      if (help && isUploading) help.textContent = 'Upload en cours... merci de patienter.';
    }

    function uploadInlineLocalFile(root, file) {
      if (!root || !file) return Promise.resolve();
      var pathInput = root.querySelector('.js-file-inline-path');
      var sourceEl = root.querySelector('.js-file-inline-source');
      var src = safe((sourceEl && sourceEl.value) || 'upload').toLowerCase();
      var folderRoot = src === 's3' ? 'Library/courses/s3' : 'Library/courses/uploads';
      var safeCourseFolder = String(webinarId || 'general').replace(/[^a-zA-Z0-9_-]/g, '_');
      var folder = folderRoot + '/' + safeCourseFolder;
      setInlineFileUploading(root, true, 'Upload...');
      var form = new FormData();
      form.append('file', file);
      form.append('folder', folder);
      return fetch('/admin/library/upload', { method: 'POST', body: form })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || data.ok === false || !data.key) {
            throw new Error(getApiErrorMessage(data, 'Upload impossible pour ce fichier.'));
          }
          if (pathInput) {
            pathInput.value = safe(data.key);
            pathInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
          if (hasSwal) Swal.fire({ icon: 'success', title: 'Fichier televerse', text: 'Le chemin MinIO a ete renseigne automatiquement.' });
        })
        .catch(function (error) {
          if (hasSwal) Swal.fire({ icon: 'error', title: 'Upload echec', text: (error && error.message) ? error.message : 'Merci de reessayer.' });
        })
        .finally(function () {
          setInlineFileUploading(root, false);
          applyInlineFileSourceBehavior(root);
        });
    }

    refreshBuilder();

    var deepLinkProcessed = false;

    function showSavedSuccess() {
      if (hasSwal) Swal.fire({ icon: 'success', title: 'Enregistre', text: 'L element a ete ajoute avec succes.' });
    }

    function showSaveError(error) {
      if (hasSwal) Swal.fire({ icon: 'error', title: 'Echec de l enregistrement', text: (error && error.message) ? error.message : 'Merci de verifier les champs et de reessayer.' });
    }

    function createSectionItem(type, value, chapterId) {
      var payload = value && value.payload ? value.payload : {};
      if (chapterId) payload.chapter_id = chapterId;
      return fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          type: type,
          title: value.title,
          status: value.status,
          payload: payload
        })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) throw new Error(getApiErrorMessage(data, 'Impossible de sauvegarder cet element pour le moment.'));
          refreshBuilder();
          showSavedSuccess();
        })
        .catch(function (error) {
          showSaveError(error);
        });
