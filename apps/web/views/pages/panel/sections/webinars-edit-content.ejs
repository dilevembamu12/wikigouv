              '<button type="button" class="rocket-icon-btn"><i class="fa-solid fa-up-down-left-right"></i></button>' +
              '<button type="button" class="rocket-icon-btn js-delete-item" data-type="file" data-id="' + id + '"><i class="fa-regular fa-trash-can"></i></button>' +
              '<button type="button" class="rocket-icon-btn js-inline-toggle" title="Collapse"><i class="fa-solid fa-angle-up"></i></button>' +
            '</div>' +
          '</div>' +
