<section class="rocket-card p-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Edit Course #<%= webinarId %></h2>
    <div class="d-flex gap-2">
      <a href="/admin/webinars/<%= encodeURIComponent(String(webinarId)) %>/edit/course" class="btn btn-primary btn-sm">Edit Course</a>
      <a href="/admin/webinars/<%= encodeURIComponent(String(webinarId)) %>/edit" class="btn btn-outline-primary btn-sm">Edit Sections</a>
      <a href="/admin/webinars?ok=course_updated" class="btn btn-outline-secondary btn-sm">Back to list</a>
    </div>
  </div>

  <div class="alert alert-success mb-4">
    Cours cree. Continuez avec le curriculum complet: sections, fichiers, lecons, sessions, devoirs, FAQ, prerequisites, cours lies et quiz.
  </div>

  <div class="rocket-builder-card border rounded p-3 mb-4 rocket-builder-header">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h3 class="h6 fw-bold mb-0 d-flex align-items-center gap-2">
        <span class="rocket-section-dot"></span>
        Curriculum
      </h3>
      <button type="button" class="btn btn-primary btn-sm js-add-section-item" data-type="chapter" data-label="Section">
        Add New Section
      </button>
    </div>
  </div>

  <div id="builderSections">
  </div>
</section>

