    function refreshBuilder() {
      builderSections.innerHTML = '<div class="text-muted small py-2">Loading...</div>';
      var typesToLoad = ['chapter'].concat(sectionGroups.map(function (g) { return g.key; }));
      Promise.all(typesToLoad.map(function (type) { return loadType(type); })).then(function () {
        renderChapterBoard();
        document.querySelectorAll('.rocket-file-inline').forEach(function (row) {
          applyInlineFileSourceBehavior(row);
          applyInlineFileDripBehavior(row);
        });
        document.querySelectorAll('.rocket-inline-item').forEach(function (row) {
          if (row.querySelector('.js-ss-inline-provider')) applyInlineSessionProviderBehavior(row);
          if (row.querySelector('.js-if-inline-type')) applyInlineInteractiveTypeBehavior(row);
        });
        enhanceInlineRichEditors();
        processDeepLinkActions();
      });
    }

    function applyInlineFileSourceBehavior(root) {
      if (!root) return;
      var sourceEl = root.querySelector('.js-file-inline-source');
      var pathInput = root.querySelector('.js-file-inline-path');
      var pathLabel = root.querySelector('.js-file-inline-path-label');
      var pathIcon = root.querySelector('.js-file-inline-path-icon i');
      var pathHelp = root.querySelector('.js-file-inline-path-help');
      var browseBtn = root.querySelector('.js-file-inline-browse');
      var typeWrap = root.querySelector('.js-file-inline-type-wrap');
      var volumeWrap = root.querySelector('.js-file-inline-volume-wrap');
      var onlineViewerWrap = root.querySelector('.js-file-inline-online-viewer') ? root.querySelector('.js-file-inline-online-viewer').closest('.form-check') : null;
      var downloadableWrap = root.querySelector('.js-file-inline-downloadable') ? root.querySelector('.js-file-inline-downloadable').closest('.form-check') : null;
      if (!sourceEl || !pathInput) return;
      var src = safe(sourceEl.value).toLowerCase();
      var isUpload = src === 'upload' || src === 's3' || src === 'secure_host';
      var isEmbed = src === 'iframe' || src === 'google_drive';
      if (pathLabel) pathLabel.textContent = isUpload ? 'Upload files from your device' : (src === 'youtube' ? 'Paste YouTube link' : src === 'vimeo' ? 'Paste Vimeo link' : isEmbed ? 'Embed link' : 'Paste external link');
      pathInput.placeholder = src === 'youtube'
        ? 'Paste YouTube link'
        : src === 'vimeo'
          ? 'Paste Vimeo link'
          : src === 'iframe'
            ? 'Paste full iframe embed code'
            : src === 'google_drive'
              ? 'Embed link starting with iframe tag'
              : isUpload
                ? 'Upload files from your device'
                : 'Paste external link';
      if (pathHelp) {
        pathHelp.textContent = isUpload
          ? 'Choisir depuis la Library, uploader en direct, ou saisir une cle objet.'
          : 'Collez le lien correspondant a la source selectionnee.';
      }
      if (pathIcon) {
        pathIcon.className = src === 'youtube' || src === 'vimeo' || src === 'external_link' || src === 'iframe'
          ? 'fa-solid fa-link'
          : src === 'google_drive'
            ? 'fa-solid fa-cube'
            : 'fa-solid fa-upload';
      }
      if (browseBtn) browseBtn.classList.toggle('d-none', !(src === 's3' || src === 'upload' || src === 'secure_host'));
      if (typeWrap) typeWrap.style.display = (src === 'youtube' || src === 'vimeo' || src === 'iframe') ? 'none' : '';
      if (volumeWrap) volumeWrap.style.display = (src === 'youtube' || src === 'vimeo' || src === 'iframe') ? 'none' : '';
      if (onlineViewerWrap) onlineViewerWrap.style.display = (src === 'youtube' || src === 'vimeo') ? 'none' : '';
      if (downloadableWrap) downloadableWrap.style.display = (src === 'iframe') ? 'none' : '';
    }

    function applyInlineFileDripBehavior(root) {
      if (!root) return;
      var dripEl = root.querySelector('.js-file-inline-drip');
      var dripWrap = root.querySelector('.js-file-inline-drip-wrap');
      if (!dripEl || !dripWrap) return;
      dripWrap.style.display = dripEl.checked ? '' : 'none';
    }

    function applyInlineSessionProviderBehavior(root) {
      if (!root) return;
      var providerEl = root.querySelector('.js-ss-inline-provider');
      if (!providerEl) return;
      var provider = safe(providerEl.value).toLowerCase();
      var linkWrap = root.querySelector('.js-ss-inline-link-wrap');
      var apiSecretWrap = root.querySelector('.js-ss-inline-api-secret-wrap');
      var apiSecretLabel = root.querySelector('.js-ss-inline-api-secret-label');
      var moderatorSecretWrap = root.querySelector('.js-ss-inline-moderator-secret-wrap');
