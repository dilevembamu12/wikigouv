    function clearDeepLinkQuery() {
      var url = new URL(window.location.href);
      ['openCreate', 'sectionAction', 'sectionId', 'fromLearning'].forEach(function (k) {
        url.searchParams.delete(k);
      });
      window.history.replaceState({}, document.title, url.pathname + (url.searchParams.toString() ? ('?' + url.searchParams.toString()) : ''));
    }

    function processDeepLinkActions() {
      if (deepLinkProcessed) return;
      var params = new URLSearchParams(window.location.search || '');
      if (params.get('fromLearning') !== '1') return;
      deepLinkProcessed = true;

      var openCreate = safe(params.get('openCreate'));
      var sectionAction = safe(params.get('sectionAction'));
      var sectionId = safe(params.get('sectionId'));

      if (openCreate) {
        if (openCreate === 'chapter') {
          var chapterBtn = document.querySelector('.js-add-section-item[data-type="chapter"]');
          if (chapterBtn) chapterBtn.click();
          clearDeepLinkQuery();
          return;
        }

        var labelMap = {
          file: 'Fichier',
          interactive_file: 'Fichier SCORM',
          text_lesson: 'Lecon texte',
          quiz: 'Quiz',
          assignment: 'Devoir'
        };
        var chapterCandidate = sectionId || '';
        buildCreateModal(openCreate, labelMap[openCreate] || openCreate, chapterCandidate).then(function (result) {
          if (!result.isConfirmed) return;
          createSectionItem(openCreate, result.value, chapterCandidate);
        });
        clearDeepLinkQuery();
        return;
      }

      if (sectionAction && sectionId) {
        var chapterRow = document.querySelector('[data-chapter-id="' + sectionId.replace(/"/g, '\\"') + '"]');
        if (sectionAction === 'edit') {
          var edit = chapterRow ? chapterRow.querySelector('.js-edit-item[data-type="chapter"]') : null;
          if (edit) edit.click();
        } else if (sectionAction === 'delete') {
          var del = chapterRow ? chapterRow.querySelector('.js-delete-item[data-type="chapter"]') : null;
          if (del) del.click();
        } else if (sectionAction === 'sort') {
          if (chapterRow) {
            chapterRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          if (hasSwal) {
            Swal.fire({
              icon: 'info',
              title: 'Tri de section',
              text: 'Le tri glisser-deposer sera active dans la prochaine passe.',
              confirmButtonText: 'OK'
            });
          }
        }
        clearDeepLinkQuery();
      }
    }

    function getApiErrorMessage(data, fallback) {
      if (data && typeof data.message === 'string' && data.message.trim()) return data.message.trim();
      if (data && typeof data.status === 'number') {
        if (data.status === 401) return 'Votre session a expire. Reconnectez-vous puis reessayez.';
        if (data.status === 403) return 'Vous n avez pas les droits pour cette action.';
        if (data.status >= 500) return 'Erreur serveur temporaire. Reessayez dans quelques instants.';
      }
      return fallback;
    }

