    function safe(v) {
      return String(v == null ? '' : v);
    }

    function toNullableNumber(value) {
      var raw = safe(value).trim();
      if (!raw) return null;
      var parsed = Number(raw);
      return Number.isFinite(parsed) ? parsed : null;
    }

    function escapeHtml(value) {
      return safe(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function fieldHtml(type, field) {
      var id = 'sw_' + type + '_' + field.key;
      var wrapStart = '<div class="rocket-modal-field mb-2" data-field-key="' + escapeHtml(field.key) + '">';
      var wrapEnd = '</div>';
      var inferredType = field.type || 'text';
      if (inferredType === 'text' && (field.key === 'date' || field.key === 'deadline')) {
        inferredType = field.key === 'deadline' ? 'date' : 'datetime-local';
      }
      if (field.type === 'textarea') {
        return wrapStart + '<label class="swal2-label">' + field.label + '</label><textarea id="' + id + '" class="swal2-textarea" placeholder="' + escapeHtml(field.placeholder || '') + '">' + escapeHtml(field.defaultValue || '') + '</textarea>' + wrapEnd;
      }
      if (field.type === 'select') {
        var optionLabels = {
          FR: 'Francais',
          EN: 'English',
          AR: 'Arabic',
          upload: 'Upload',
          youtube: 'YouTube',
          vimeo: 'Vimeo',
          external_link: 'External Link',
          google_drive: 'Google Drive',
          iframe: 'iFrame',
          s3: 'Amazon S3',
          secure_host: 'Secure Host (Bunny)',
          local: 'Local',
          big_blue_button: 'BigBlueButton',
          google_meet: 'Google Meet',
          agora: 'Agora',
          adobe_captivate: 'Adobe Captivate',
          i_spring: 'iSpring',
          custom: 'Custom',
          free: 'Free',
          paid: 'Paid'
        };
        var options = (field.options || []).map(function (opt) {
          var selected = String(opt) === String(field.defaultValue || '') ? ' selected' : '';
          var label = optionLabels[opt] || String(opt).replace(/_/g, ' ');
          return '<option value="' + escapeHtml(opt) + '"' + selected + '>' + escapeHtml(label) + '</option>';
        }).join('');
        return wrapStart + '<label class="swal2-label">' + field.label + '</label><select id="' + id + '" class="swal2-select">' + options + '</select>' + wrapEnd;
      }
      if (field.type === 'checkbox') {
        var checked = field.defaultValue ? ' checked' : '';
        return wrapStart + '<div class="swal2-checkbox" style="display:flex;justify-content:flex-start;"><input type="checkbox" id="' + id + '"' + checked + '><label for="' + id + '">' + escapeHtml(field.label) + '</label></div>' + wrapEnd;
      }
      return wrapStart + '<label class="swal2-label">' + field.label + '</label><input id="' + id + '" type="' + escapeHtml(inferredType) + '" class="swal2-input" placeholder="' + escapeHtml(field.placeholder || '') + '" value="' + escapeHtml(field.defaultValue || '') + '">' + wrapEnd;
    }

    function renderChapterOptions(selectedValue) {
      var selected = safe(selectedValue);
      var chapters = Array.isArray(sectionItemsByType.chapter) ? sectionItemsByType.chapter : [];
      var options = '<option value=""' + (selected === '' ? ' selected' : '') + '>Contenu general / Intro</option>';
      options += chapters.map(function (chapter) {
        var chapterId = safe(chapter.id);
        var chapterTitle = safe(chapter.title || 'Section');
        return '<option value="' + escapeHtml(chapterId) + '"' + (chapterId === selected ? ' selected' : '') + '>' + escapeHtml(chapterTitle) + '</option>';
      }).join('');
      return options;
    }

    function enhanceSectionSelect(type, currentChapterId, lockToChapter) {
      var typesWithSection = ['interactive_file', 'file', 'text_lesson', 'session', 'assignment'];
      if (typesWithSection.indexOf(type) < 0) return;
      var sectionWrap = fieldWrapper(type, 'chapter_id');
      if (!sectionWrap) return;
      var selectId = 'sw_' + type + '_chapter_id';
      var selectEl = document.getElementById(selectId);
      var selected = safe(currentChapterId || (selectEl ? selectEl.value : ''));
      if (!selectEl || selectEl.tagName.toLowerCase() !== 'select') {
        sectionWrap.innerHTML = '<label class="swal2-label">Section</label><select id="' + selectId + '" class="swal2-select">' + renderChapterOptions(selected) + '</select>';
        selectEl = document.getElementById(selectId);
      } else {
        selectEl.innerHTML = renderChapterOptions(selected);
      }
      if (selectEl) {
        selectEl.value = selected;
        if (lockToChapter) {
          selectEl.setAttribute('disabled', 'disabled');
          var hintId = 'sw_' + type + '_chapter_hint';
          if (!document.getElementById(hintId)) {
            var hint = document.createElement('div');
            hint.id = hintId;
            hint.className = 'swal2-label';
            hint.style.fontSize = '.78rem';
            hint.style.marginTop = '.35rem';
            hint.style.color = '#7d8fb0';
            hint.textContent = 'Section fixee automatiquement selon le contexte d ouverture.';
            sectionWrap.appendChild(hint);
          }
        } else {
          selectEl.removeAttribute('disabled');
        }
      }
    }

    var courseOptionsCache = null;
    var courseFileOptionsCache = null;
    function loadCourseOptions() {
      if (Array.isArray(courseOptionsCache)) return Promise.resolve(courseOptionsCache);
      return fetch('/api/admin/education/courses?page=1&pageSize=300', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          var items = data && Array.isArray(data.items) ? data.items : [];
          courseOptionsCache = items.map(function (it) {
            var id = safe(it.id);
            var title = safe(it.title || 'Untitled');
            return { id: id, title: title };
          }).filter(function (x) { return !!x.id; });
          return courseOptionsCache;
        })
        .catch(function () {
          courseOptionsCache = [];
          return courseOptionsCache;
        });
    }

    function enhanceCourseSearchSelect(type, key, currentValue) {
      var fieldId = 'sw_' + type + '_' + key;
      var selectEl = document.getElementById(fieldId);
      if (!selectEl) return Promise.resolve();
      var selected = safe(currentValue || selectEl.value || '');
      return loadCourseOptions().then(function (options) {
        var opts = '<option value="">Select a course</option>' + options.map(function (opt) {
          return '<option value="' + escapeHtml(opt.id) + '" title="' + escapeHtml(opt.id) + '"' + (safe(opt.id) === selected ? ' selected' : '') + '>' + escapeHtml(opt.title) + '</option>';
        }).join('');
        selectEl.innerHTML = opts;
        selectEl.value = selected;
        var wrapper = selectEl.closest('.rocket-modal-field');
        if (!wrapper) return;
        var filterId = 'swf_' + type + '_' + key;
        var filter = document.getElementById(filterId);
        if (!filter) {
          filter = document.createElement('input');
          filter.id = filterId;
          filter.type = 'text';
          filter.className = 'swal2-input';
          filter.placeholder = 'Search course by ID or title...';
          filter.style.marginTop = '0';
          wrapper.insertBefore(filter, selectEl);
        }
        var metaId = 'swmeta_' + type + '_' + key;
        var meta = document.getElementById(metaId);
        if (!meta) {
          meta = document.createElement('div');
          meta.id = metaId;
          meta.className = 'swal2-label';
          meta.style.fontSize = '.78rem';
          meta.style.marginTop = '.35rem';
          meta.style.color = '#7d8fb0';
          wrapper.appendChild(meta);
        }
        function syncMeta() {
          var selectedId = safe(selectEl.value || '');
          meta.textContent = selectedId ? ('Course ID: ' + selectedId) : 'Course ID: none';
        }
        syncMeta();
        selectEl.addEventListener('change', syncMeta);
        filter.addEventListener('input', function () {
          var q = safe(filter.value).toLowerCase();
          Array.prototype.forEach.call(selectEl.options, function (opt) {
            var keep = !q || safe(opt.textContent).toLowerCase().indexOf(q) !== -1;
            opt.hidden = !keep;
          });
        });
      });
    }

    function loadCourseFileOptions() {
      if (Array.isArray(courseFileOptionsCache)) return Promise.resolve(courseFileOptionsCache);
      return fetch('/admin/webinars/' + encodeURIComponent(webinarId) + '/sections?type=file', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          var items = data && Array.isArray(data.items) ? data.items : [];
          courseFileOptionsCache = items.map(function (it) {
            var id = safe(it.id);
            var title = safe(it.title || 'Untitled file');
            return { id: id, title: title };
          }).filter(function (x) { return !!x.id; });
          return courseFileOptionsCache;
        })
        .catch(function () {
          courseFileOptionsCache = [];
          return courseFileOptionsCache;
        });
    }

    function normalizeAttachmentIds(raw) {
      var txt = safe(raw).trim();
      if (!txt) return [];
      try {
        var parsed = JSON.parse(txt);
        if (Array.isArray(parsed)) return parsed.map(function (v) { return safe(v).trim(); }).filter(Boolean);
      } catch (_) {}
      return txt.split(',').map(function (v) { return safe(v).trim(); }).filter(Boolean);
    }

    function enhanceTextLessonAttachmentsPicker() {
      var input = document.getElementById('sw_text_lesson_attachments');
      if (!input || input.dataset.attachmentsEnhanced === '1') return;
      input.dataset.attachmentsEnhanced = '1';
      input.style.display = 'none';

      var wrap = input.closest('.rocket-modal-field');
      if (!wrap) return;

      var root = document.createElement('div');
      root.className = 'rocket-attachments-picker';
      root.innerHTML = '' +
        '<input type="text" class="swal2-input rocket-attachments-search" placeholder="Rechercher un fichier...">' +
        '<select multiple class="rocket-attachments-select"></select>' +
        '<div class="rocket-attachments-selected"></div>' +
        '<div class="rocket-field-hint">Selection multiple possible. Les IDs sont geres automatiquement.</div>';
      wrap.appendChild(root);

      var searchEl = root.querySelector('.rocket-attachments-search');
      var selectEl = root.querySelector('.rocket-attachments-select');
      var selectedEl = root.querySelector('.rocket-attachments-selected');
      var initialIds = normalizeAttachmentIds(input.value);

      function renderSelectedChips() {
        var selected = Array.prototype.slice.call(selectEl.selectedOptions).map(function (opt) {
          return { id: safe(opt.value), title: safe(opt.textContent) };
        });
        selectedEl.innerHTML = selected.map(function (s) {
          return '<span class="rocket-attachments-chip" title="' + escapeHtml(s.id) + '">' + escapeHtml(s.title) + '</span>';
        }).join('');
        input.value = JSON.stringify(selected.map(function (s) { return s.id; }));
      }

      loadCourseFileOptions().then(function (options) {
        selectEl.innerHTML = options.map(function (opt) {
          var selected = initialIds.indexOf(opt.id) >= 0 ? ' selected' : '';
          return '<option value="' + escapeHtml(opt.id) + '"' + selected + ' title="' + escapeHtml(opt.id) + '">' + escapeHtml(opt.title) + '</option>';
        }).join('');
        renderSelectedChips();
      });

      selectEl.addEventListener('change', renderSelectedChips);
      if (searchEl) {
        searchEl.addEventListener('input', function () {
          var q = safe(searchEl.value).toLowerCase();
          Array.prototype.forEach.call(selectEl.options, function (opt) {
            var keep = !q || safe(opt.textContent).toLowerCase().indexOf(q) >= 0 || safe(opt.value).toLowerCase().indexOf(q) >= 0;
            opt.hidden = !keep;
          });
        });
      }
    }

    function validateRequiredModalFields(type, title, payload) {
      var trimmedTitle = safe(title).trim();
      if (!trimmedTitle) {
        return 'Le titre est obligatoire.';
      }
      if (type === 'interactive_file') {
        var locale = safe(payload.locale).trim();
        var scormType = safe(payload.interactive_type).trim();
        var accessibility = safe(payload.accessibility).trim();
        var zipPath = safe(payload.file_path).trim();
        if (!locale) return 'La langue est obligatoire.';
        if (!scormType) return 'Le type SCORM est obligatoire.';
        if (!accessibility) return 'Le niveau d accessibilite est obligatoire.';
        if (!zipPath) return 'Le champ ZIP File Path est obligatoire.';
      }
      return '';
    }

    function fieldWrapper(type, key) {
      return document.querySelector('[data-field-key="' + key + '"]');
    }

    function setFieldVisible(type, key, visible) {
      var wrap = fieldWrapper(type, key);
      if (!wrap) return;
      wrap.style.display = visible ? '' : 'none';
    }

    function setFieldLabel(type, key, label) {
      var wrap = fieldWrapper(type, key);
      if (!wrap) return;
      var lbl = wrap.querySelector('.swal2-label');
      if (lbl) lbl.textContent = label;
    }

    function setFieldPlaceholder(type, key, placeholder) {
      var el = document.getElementById('sw_' + type + '_' + key);
      if (el && 'placeholder' in el) el.placeholder = placeholder;
    }

    function applyDynamicRules(type) {
      if (type === 'file') {
        var storageEl = document.getElementById('sw_file_storage');
        var storage = storageEl ? storageEl.value : 'upload';
        var isUpload = storage === 'upload' || storage === 's3' || storage === 'secure_host';
        var isEmbed = storage === 'iframe' || storage === 'google_drive';
        setFieldVisible(type, 'online_viewer', storage !== 'youtube' && storage !== 'vimeo');
        setFieldVisible(type, 'downloadable', true);
        setFieldVisible(type, 'file_path', true);
        setFieldLabel(type, 'file_path', isUpload ? 'Upload files from your device' : (storage === 'youtube' ? 'Paste YouTube link' : storage === 'vimeo' ? 'Paste Vimeo link' : isEmbed ? 'Embed link' : 'Paste external link'));
        setFieldPlaceholder(type, 'file_path', isUpload
          ? 'Select a File or object key'
          : storage === 'youtube'
            ? 'Paste YouTube link'
            : storage === 'vimeo'
              ? 'Paste Vimeo link'
              : storage === 'iframe'
                ? 'Paste full iframe embed code'
                : storage === 'google_drive'
                  ? 'Embed link starting with iframe tag'
                  : 'Paste external link');
      }

      if (type === 'session') {
        var providerEl = document.getElementById('sw_session_session_api');
        var provider = providerEl ? providerEl.value : 'local';
        setFieldVisible(type, 'link', provider === 'local' || provider === 'zoom' || provider === 'google_meet');
        setFieldVisible(type, 'api_secret', provider !== 'agora');
        setFieldVisible(type, 'moderator_secret', provider === 'big_blue_button');
        setFieldVisible(type, 'agora_chat', provider === 'agora');
        setFieldLabel(type, 'api_secret', (provider === 'zoom' || provider === 'google_meet') ? 'Meeting Password' : 'Password');
      }

      if (type === 'interactive_file') {
        var scormEl = document.getElementById('sw_interactive_file_interactive_type');
        var scorm = scormEl ? scormEl.value : 'adobe_captivate';
        setFieldVisible(type, 'interactive_file_name', scorm === 'custom');
      }

      if (type === 'text_lesson' || type === 'assignment' || type === 'file' || type === 'interactive_file' || type === 'session') {
        var dripEl = document.getElementById('sw_' + type + '_sequence_content');
        var drip = dripEl ? !!dripEl.checked : false;
        setFieldVisible(type, 'check_previous_parts', drip);
        setFieldVisible(type, 'access_after_day', drip);
      }
    }

    function bindDynamicRules(type) {
      var watchMap = {
        file: ['storage', 'sequence_content'],
        session: ['session_api', 'sequence_content'],
        interactive_file: ['interactive_type', 'sequence_content'],
        text_lesson: ['sequence_content'],
        assignment: ['sequence_content']
      };
      (watchMap[type] || []).forEach(function (key) {
        var el = document.getElementById('sw_' + type + '_' + key);
        if (!el) return;
        el.addEventListener('change', function () { applyDynamicRules(type); });
      });
      applyDynamicRules(type);
    }

    function enhanceModalSelectFilter(type) {
      var schema = typeSchemas[type] || { fields: [] };
      (schema.fields || []).forEach(function (field) {
        if (field.type !== 'select') return;
        var selectEl = document.getElementById('sw_' + type + '_' + field.key);
        if (!selectEl) return;
        if (selectEl.options.length < 9) return;
        var wrapper = selectEl.closest('.rocket-modal-field');
        if (!wrapper) return;
        var filterId = 'swf_' + type + '_' + field.key;
        if (document.getElementById(filterId)) return;
        var input = document.createElement('input');
        input.id = filterId;
        input.type = 'text';
        input.className = 'swal2-input';
        input.placeholder = 'Search...';
        input.style.marginTop = '0';
        wrapper.insertBefore(input, selectEl);
        input.addEventListener('input', function () {
          var q = String(input.value || '').toLowerCase();
          Array.prototype.forEach.call(selectEl.options, function (opt) {
            var keep = !q || String(opt.textContent || '').toLowerCase().indexOf(q) !== -1;
            opt.hidden = !keep;
          });
        });
      });
    }

    function enhanceModalRichText(type) {
      var schema = typeSchemas[type] || { fields: [] };
      var richKeys = { content: true, description: true, summary: true, answer: true };
      (schema.fields || []).forEach(function (field) {
        if (field.type !== 'textarea') return;
        if (!richKeys[field.key]) return;
        var textarea = document.getElementById('sw_' + type + '_' + field.key);
        if (!textarea || textarea.dataset.richified === '1') return;
        textarea.dataset.richified = '1';
        textarea.style.display = 'none';
        var box = document.createElement('div');
        box.className = 'rocket-rich';
        var toolbar = document.createElement('div');
        toolbar.className = 'rocket-rich-toolbar';
        toolbar.innerHTML =
          '<button type="button" class="rocket-rich-btn" data-cmd="bold"><b>B</b></button>' +
          '<button type="button" class="rocket-rich-btn" data-cmd="italic"><i>I</i></button>' +
          '<button type="button" class="rocket-rich-btn" data-cmd="insertUnorderedList"><i class="fa-solid fa-list-ul"></i></button>' +
          '<button type="button" class="rocket-rich-btn" data-cmd="insertOrderedList"><i class="fa-solid fa-list-ol"></i></button>' +
          '<button type="button" class="rocket-rich-btn" data-cmd="createLink"><i class="fa-solid fa-link"></i></button>';
        var editor = document.createElement('div');
        editor.className = 'rocket-rich-editor';
        editor.contentEditable = 'true';
        editor.dataset.placeholder = field.placeholder || 'Write content...';
        editor.innerHTML = textarea.value || '';
        box.appendChild(toolbar);
        box.appendChild(editor);
        textarea.parentNode.insertBefore(box, textarea.nextSibling);
        toolbar.addEventListener('click', function (ev) {
          var btn = ev.target.closest('.rocket-rich-btn');
          if (!btn) return;
          var cmd = btn.getAttribute('data-cmd');
          if (!cmd) return;
          editor.focus();
          if (cmd === 'createLink') {
            var url = window.prompt('Enter URL');
            if (!url) return;
            document.execCommand(cmd, false, url);
          } else {
            document.execCommand(cmd, false, null);
          }
          textarea.value = editor.innerHTML;
        });
        editor.addEventListener('input', function () {
          textarea.value = editor.innerHTML;
        });
      });
    }

    function addFieldHint(type, key, text) {
      var wrap = fieldWrapper(type, key);
      if (!wrap || !text) return;
      var hintId = 'sw_' + type + '_' + key + '_hint';
      if (document.getElementById(hintId)) return;
      var hint = document.createElement('div');
      hint.id = hintId;
      hint.className = 'rocket-field-hint';
      hint.textContent = text;
      wrap.appendChild(hint);
    }

    function addCharCounter(type, key, max) {
      var el = document.getElementById('sw_' + type + '_' + key);
      if (!el) return;
      var wrap = fieldWrapper(type, key);
      if (!wrap) return;
      var id = 'sw_' + type + '_' + key + '_counter';
      var counter = document.getElementById(id);
      if (!counter) {
        counter = document.createElement('div');
        counter.id = id;
        counter.className = 'rocket-char-counter';
        wrap.appendChild(counter);
      }
      var refresh = function () {
        var len = safe(el.value || '').length;
        counter.textContent = max ? (len + ' / ' + max + ' caracteres') : (len + ' caracteres');
      };
      refresh();
      el.addEventListener('input', refresh);
    }

