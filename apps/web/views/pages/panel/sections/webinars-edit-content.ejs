                  '<label class="rocket-radio-inline"><input type="radio" name="file_access_' + id + '" value="paid"' + (accessibility === 'paid' ? ' checked' : '') + '> Paid</label>' +
                '</div>' +
              '</div>' +
              '<div class="col-12"><label class="form-label js-file-inline-path-label">File Path</label><div class="rocket-icon-input"><span class="icon js-file-inline-path-icon"><i class="fa-solid fa-link"></i></span><input id="' + escapeHtml(pathInputId) + '" class="form-control js-file-inline-path" value="' + escapeHtml(filePath) + '" placeholder="https://... ou chemin MinIO"><button type="button" class="btn btn-outline-secondary js-open-library-picker" data-target-input="' + escapeHtml(pathInputId) + '">Library</button><button type="button" class="btn btn-outline-primary js-preview-library-file" data-target-input="' + escapeHtml(pathInputId) + '"><i class="fa-regular fa-eye"></i></button><button type="button" class="btn btn-browse d-none js-file-inline-browse">Browse</button><input class="d-none js-file-inline-device-file" type="file"></div><div class="form-text js-file-inline-path-help">Choisir depuis la Library (upload direct possible) ou coller un lien.</div></div>' +
