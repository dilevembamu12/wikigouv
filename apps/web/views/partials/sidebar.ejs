<aside id="sidebar-wrapper" class="h-100 d-flex flex-column px-3 py-4 overflow-auto">
  <div class="sidebar-brand text-center mb-2">
    <a href="/" class="text-decoration-none fw-bold">WIKIGouv</a>
  </div>
  <div class="sidebar-brand sidebar-brand-sm text-center mb-3">
    <a href="/" class="text-decoration-none fw-bold"></a>
  </div>

  <ul class="sidebar-menu list-unstyled mb-0">
    <% sections.forEach((section) => { %>
      <% const visibleItems = section.items.filter((item) => canSee(item.roles)); %>
      <% if (visibleItems.length > 0) { %>
        <% if (section.header) { %>
          <li class="menu-header text-uppercase small text-muted mt-3 mb-2"><%= section.header %></li>
        <% } %>

        <% visibleItems.forEach((item) => { %>
          <% if (item.children && item.children.length > 0) { %>
            <% const visibleChildren = item.children.filter((child) => canSee(child.roles)); %>
            <% if (visibleChildren.length > 0) { %>
              <% const childActive = visibleChildren.some((child) => isPathActive(child.href)); %>
              <li class="nav-item dropdown <%= childActive ? 'active' : '' %> mb-1">
                <a href="#" class="rocket-sidebar-link nav-link has-dropdown <%= childActive ? 'active' : '' %>" data-toggle="dropdown" aria-expanded="<%= childActive ? 'true' : 'false' %>">
                  <span><%= item.label %></span>
                  <span class="ms-auto small">▾</span>
                </a>
                <ul class="dropdown-menu list-unstyled ps-3 mt-1 <%= childActive ? 'open' : '' %>" style="<%= childActive ? 'display:block;' : 'display:none;' %>">
                  <% visibleChildren.forEach((child) => { %>
                    <% const activeChild = isPathActive(child.href); %>
                    <li class="mb-1">
                      <a class="rocket-sidebar-link nav-link <%= activeChild ? 'active' : '' %>" href="<%= child.href %>"><%= child.label %></a>
                    </li>
                  <% }) %>
                </ul>
              </li>
            <% } %>
          <% } else { %>
            <% const activeItem = (item.key && page?.activeNav === item.key) || isPathActive(item.href); %>
            <li class="mb-1">
              <a href="<%= item.href %>" class="rocket-sidebar-link <%= activeItem ? 'active' : '' %> <%= item.danger ? 'text-danger' : '' %>">
                <span><%= item.label %></span>
                <% if (item.comingSoon) { %><small class="text-muted ms-2">Soon</small><% } %>
              </a>
            </li>
          <% } %>
        <% }); %>
      <% } %>
    <% }); %>
  </ul>
</aside>

<style>
  #sidebar-wrapper .nav-item.dropdown {
    position: static;
  }

  #sidebar-wrapper .dropdown-menu {
    position: static !important;
    inset: auto !important;
    transform: none !important;
    float: none !important;
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    padding: 0.25rem 0 0.25rem 0.75rem;
    margin: 0;
  }

  #sidebar-wrapper .dropdown-menu.open {
    display: block;
  }
</style>
