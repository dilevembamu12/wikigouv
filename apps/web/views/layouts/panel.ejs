<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { page }) %>
</head>
<body>
  <div class="container-fluid px-0">
    <div class="d-flex min-vh-100">
      <aside class="bg-white border-end" style="width: 250px;">
        <%- include('../partials/sidebar', { page }) %>
      </aside>
      <div class="flex-grow-1">
        <header class="d-flex align-items-center justify-content-between px-4 py-3" style="background: var(--rocket-blue);">
          <div class="text-white fw-semibold">
            <i class="fa-solid fa-bars me-2"></i>
          </div>
          <div class="d-flex align-items-center gap-2">
            <a href="#" class="rocket-top-icon"><i class="fa-regular fa-moon"></i></a>
            <a href="#" class="rocket-top-icon"><i class="fa-solid fa-globe"></i></a>
            <a href="#" class="rocket-top-icon"><i class="fa-regular fa-bell"></i></a>
            <a href="/logout" class="rocket-top-icon bg-danger"><i class="fa-solid fa-right-from-bracket"></i></a>
            <span class="text-white small ms-2"><%= page?.user?.preferredUsername ?? page?.user?.email ?? 'Admin' %></span>
          </div>
        </header>
        <main class="p-4">
          <%- include('../partials/alerts', { page }) %>
          <%- include(contentTemplate, { page, data }) %>
        </main>
      </div>
    </div>
  </div>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/panel-sidebar.js"></script>
</body>
</html>
