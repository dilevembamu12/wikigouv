NODE_ENV=development

# API
PORT=4000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=wikigouv
MYSQL_USER=wikigouv
MYSQL_PASSWORD=wikigouv
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_DIR=./logs/api

# Keycloak backend validation
KEYCLOAK_ISSUER_URL=http://localhost:18080/realms/wikigouv
KEYCLOAK_REALM=wikigouv
KEYCLOAK_WEB_CLIENT_ID=wikigouv-web
KEYCLOAK_API_CLIENT_ID=wikigouv-api
KEYCLOAK_ADMIN_CLIENT_ID=wikigouv-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_JWKS_URI=http://localhost:18080/realms/wikigouv/protocol/openid-connect/certs
KEYCLOAK_LOGOUT_URL=http://localhost:18080/realms/wikigouv/protocol/openid-connect/logout

# Keycloak JWT validation (required by API)
JWT_ISSUER=http://localhost:18080/realms/wikigouv
JWT_AUDIENCE=wikigouv-api
JWKS_URI=http://localhost:18080/realms/wikigouv/protocol/openid-connect/certs

# Web public env
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:18080
NEXT_PUBLIC_KEYCLOAK_REALM=wikigouv
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=wikigouv-web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_E2E_MOCK_AUTH=false
OIDC_SCOPE=openid

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wikigouv-docs
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_LIBRARY_BUCKET=general
MINIO_LIBRARY_ROOT_PREFIX=Fintrax/Library
LIBRARY_WRITE_ROLES=AGENT,FORMATEUR,ADMIN,DIRECTION,AUDITEUR,SUPER_ADMIN

# AI
LLM_PROVIDER=ollama
LLM_API_KEY=
VECTOR_STORE_PROVIDER=qdrant
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
